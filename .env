
<div class="p-3">



  <div class="row-item d-flex justify-content-between bg-white px-2"style="border:none;">
    <span style="font-size:15px; font-weight:600;">
      Invoice Date
    </span>
    <span class="text-end w-50" style="font-size:15px;">
      <%= ride.created_at %>
    </span>
  </div>

  <div class="row-item d-flex justify-content-between bg-white px-2" style="border:none;">
    <span style="font-size:15px; font-weight:600;">
      State
    </span>
    <span class="text-end w-50" style="font-size:15px;">
      <%= state %>
    </span>
  </div>



 <div class="row-item d-flex justify-content-between bg-white px-2" style="border:none;">
    <span style="font-size:15px; font-weight:600;">
      Tax Category
    </span>
    <span class="text-end w-50" style="font-size:15px;">
     Other local transportation services of
passengers n.e.c. (996419)
    </span>
  </div>
  
  <div class="row-item d-flex justify-content-between bg-white px-2">
    <span style="font-size:15px; font-weight:600;">
      Place of Supply
    </span>
    <span class="text-end w-50" style="font-size:15px;">
 <%= state %>
    </span>
  </div>

</div>

