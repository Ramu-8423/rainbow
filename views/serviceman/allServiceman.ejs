<style>
  .file-box {
    width: 50px;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f1f1;
    margin-right: 6px;
    cursor: pointer;
    vertical-align: middle;
  }

  .file-box img {
    display: block;
  }

  .file-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ===========================
     RESPONSIVE PAGINATION
  =========================== */

  .pagination-container {
    margin-top: 25px;
    padding: 12px 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #ddd;
    gap: 12px;
  }

  .pagination-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pagination-left select {
    padding: 5px 8px;
    border-radius: 4px;
    border: 1px solid #ccc;
  }

  .pagination-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pg-btn {
    padding: 6px 12px;
    border: 1px solid #007bff;
    color: #007bff;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .pg-btn:hover {
    background: #007bff;
    color: #fff;
  }

  .pg-input {
    width: 45px;
    text-align: center;
    padding: 5px;
    border: 1px solid #aaa;
    border-radius: 4px;
  }

  /* MOBILE */
  @media(max-width: 600px){
    .pagination-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .pagination-right,
    .pagination-left {
      width: 100%;
      justify-content: space-between;
    }
  }

  /* FILTER + HEADER */
  .card-header {
    gap: 10px;
  }

  .filter-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start !important;
    }

    #tableSearch {
      width: 100% !important;
      margin: 0 !important;
    }

    .filter-form input {
      width: 48% !important;
    }

    .filter-form button,
    .filter-form a {
      width: 100%;
    }
  }

  .card-header .form-control {
    border-radius: 0 !important;
  }
</style>

<div class="main-content">
<section class="section">
<div class="card">




 <div class="card-header d-flex justify-content-between align-items-center flex-wrap">

  <h4 class="mb-0">Serviceman List</h4>


 <div class="d-flex gap-2 flex-wrap">
    <a href="/serviceman"
       class="btn btn-sm <%= !status ? 'btn-primary' : 'btn-secondary' %>"
       style="border-radius:0;">
      All
    </a>

    <a href="/serviceman?status=1"
       class="btn btn-sm <%= status == 1 ? 'btn-primary' : 'btn-secondary' %>"
       style="border-radius:0;">
      Active
    </a>

    <a href="/serviceman?status=0"
       class="btn btn-sm <%= status == 0 ? 'btn-primary' : 'btn-secondary' %>"
       style="border-radius:0;">
      Inactive
    </a>

  </div>
  <!-- SEARCH -->
  <input 
    type="text"
    id="tableSearch"
    placeholder="Search..."
    class="form-control mx-3"
    style="width:220px;"
  />


  <!-- FILTER FORM -->
  <form class="filter-form d-flex align-items-center" method="GET">

    <input type="date" name="from" value="<%= from || '' %>" class="form-control" style="width:150px;" />
    <input type="date" name="to" value="<%= to || '' %>" class="form-control" style="width:150px;" />

    <button type="submit" class="btn btn-primary btn-sm" style="border-radius:0;">
      Filter
    </button>

    <% if (isFiltered) { %>
      <a href="/serviceman" class="btn btn-secondary btn-sm" style="border-radius:0;">
        Reset
      </a>
    <% } %>

  </form>

</div>

















<!-- TABLE -->
<div class="card-body">
<div class="table-responsive">
<table class="table table-bordered table-striped">

<thead>
<tr>
  <th>ID</th>
  <th>Name</th>
  <th>Mobile</th>
  <th>Wallet</th>
  <th>Gender</th>
  <th>Status</th>
  <th>Login Status</th>
  <th>Image</th>
  <th class="date-col">Date</th>
</tr>
</thead>

<tbody>
<% if(servicemen.length>0){ %>
<% servicemen.forEach(s=>{ %>
<tr>
  <td><%= s.id %></td>
  <td><%= s.first_name %> <%= s.last_name||'' %></td>
  <td><%= s.mobile %></td>
  <td><%= s.wallet %></td>
  <td><%= s.gender||'-' %></td>

  <!-- STATUS -->
  <td style="white-space:nowrap;">
    <select onchange="changeStatus('<%= s.id %>',this.value)"
      style="
        width:110px;
        padding:3px 6px;
        font-size:13px;
        border-radius:3px;
        cursor:pointer;
        border:1px solid <%= s.login_status==1?'#28a745':'#dc3545' %>;
        color:<%= s.login_status==1?'#28a745':'#dc3545' %>;
        font-weight:600;">
      <option value="1" <%= s.login_status==1?'selected':'' %>>Active</option>
      <option value="0" <%= s.login_status==0?'selected':'' %>>Inactive</option>
    </select>

    <% if(s.login_status==0 && s.reject_reasion){ %>
      <div style="margin-top:4px;font-size:11px;color:#dc3545;font-weight:500;">
        Reason: <%= s.reject_reasion %>
      </div>
    <% } %>
  </td>


  <td class="date-col">
  <% if (s.online_status == 1) { %>
    <span class="fw-bold text-success d-inline-flex align-items-center gap-1">
      <i class="bi bi-wifi fw-bold"></i> Online
    </span>
  <% } else { %>
    <span class="fw-bold text-danger d-inline-flex align-items-center gap-1">
      <i class="bi bi-wifi-off fw-bold"></i> Offline
    </span>
  <% } %>
</td>

   

  <!-- IMAGE -->
  <td>
    <% if(s.profile_photo){ %>
      <div class="file-box">
        <img src="/<%= s.profile_photo %>" class="file-thumb"
             onclick="openImageModal('/<%= s.profile_photo %>')">
      </div>
    <% } else { %> — <% } %>
  </td>

  <!-- DATE -->
  <td class="date-col"><%= s.created_at %></td>
</tr>
<% }) %>
<% } else { %>
<tr><td colspan="8" class="text-center">No data found</td></tr>
<% } %>
</tbody>

</table>
</div>
</div>

</div>
</section>
</div>

<!-- IMAGE MODAL -->
<div id="imageModal" style="
  display:none;position:fixed;
  top:0;left:0;width:100%;height:100%;
  background:rgba(0,0,0,0.7);
  justify-content:center;align-items:center;
  z-index:9999;">
  <span onclick="closeModal()" style="position:absolute;top:20px;right:30px;font-size:35px;color:#fff;cursor:pointer;">&times;</span>
  <img id="modalImage" style="max-width:80%;max-height:80%;border-radius:10px;">
</div>

<!-- SweetAlert CDN -->
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

<script>
function openImageModal(src){
  modalImage.src=src;
  imageModal.style.display="flex";
}
function closeModal(){
  imageModal.style.display="none";
}

tableSearch.addEventListener("keyup",function(){
  let v=this.value.toLowerCase();
  document.querySelectorAll("tbody tr").forEach(r=>{
    r.style.display=r.innerText.toLowerCase().includes(v)?"":"none";
  });
});

/* SAME AS USERS */
function changeStatus(id,newStatus){
  let txt=newStatus==1
    ?"You want to activate this serviceman?"
    :"You want to deactivate this serviceman?";

  swal({
    title:"Are you sure?",
    text:txt,
    icon:"warning",
    buttons:true,
    dangerMode:true
  }).then(ok=>{
    if(!ok){ location.reload(); return; }

    if(newStatus==0){
      swal({
        title:"Reason Required",
        text:"Please enter reason:",
        content:"input",
        buttons:true
      }).then(reason=>{
        if(!reason){
          swal("Reason is required!",{icon:"error"});
          location.reload(); return;
        }
        location.href=`/serviceman-status-update/${id}?status=0&reason=${encodeURIComponent(reason)}`;
      });
    } else {
      location.href=`/serviceman-status-update/${id}?status=1`;
    }
  });
}
</script>
