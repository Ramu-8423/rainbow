<style>
  .file-box {
    width: 50px;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f1f1;
    margin-right: 6px;
    cursor: pointer;
    vertical-align: middle;
  }

  .card-header { gap:10px; }
  .card-header .form-control { border-radius:0!important; }
</style>

<div class="main-content">
  <section class="section">

    <!-- ===================== COUPONS LIST ===================== -->
    <div class="card">

      <!-- HEADER -->
      <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h4 class="mb-0">Coupons List</h4>
        
        

        <!-- SEARCH -->
        <input type="text" id="tableSearch"
               placeholder="Search..."
               class="form-control mx-3"
               style="width:220px;" />
               
               
               <button class="btn btn-primary btn-sm"
        style="border-radius:0; margin-left:auto;"
        onclick="openAddCouponModal()">
  + Add Coupon
</button>

      </div>

      <!-- TABLE -->
      <div class="card-body">
        <div class="table-responsive">

          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Code</th>
                <th>Title</th>
                <th>Discount %</th>
                <th>Type</th>
                <th>Expiry</th>
                <th>Status</th>
                <th>Date</th>
                <th>Delete</th>
              </tr>
            </thead>

            <tbody>
              <% if(coupons.length > 0){ %>
                <% coupons.forEach(c => { %>
                  <tr>
                    <td><%= c.id %></td>
                    <td><%= c.code %></td>
                    <td><%= c.title %></td>
                    <td><%= c.discount_percent %>%</td>
                    <td><%= c.type == 1 ? "Services" : "Rides" %></td>
                    <td><%= c.expires_at %></td>
                   <td>
  <select
    onchange="changeCouponStatus('<%= c.id %>', this.value, '<%= c.status %>')"
    style="
      width:110px;
      padding:3px 6px;
      border-radius:3px;
      cursor:pointer;
      font-weight:600;
      font-size:13px;
      border:1px solid <%= c.status == 1 ? '#28a745' : '#dc3545' %>;
      color:<%= c.status == 1 ? '#28a745' : '#dc3545' %>;
    "
  >
    <option value="1" <%= c.status == 1 ? 'selected' : '' %>>Active</option>
    <option value="0" <%= c.status == 0 ? 'selected' : '' %>>Inactive</option>
  </select>
</td>

                    <td><%= c.created_at %></td>
                    <td>
  <button
    class="btn btn-danger btn-sm"
    style="border-radius:0;"
    onclick="deleteCoupon('<%= c.id %>')">
    Delete
  </button>
</td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center">No Coupons Found</td>
                </tr>
              <% } %>
            </tbody>
          </table>

        </div>
      </div>
    </div>

    <!-- ===================== USED COUPONS ===================== -->
    <div class="card mt-4">

      <div class="card-header">
        <h4 class="mb-0">Used Coupons</h4>
      </div>

      <div class="card-body">
        <div class="table-responsive">

          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Coupon Code</th>
                <th>Title</th>
                <th>User ID</th>
                <th>Discount %</th>
                <th>Type</th>
                <th>Status</th>
                <th>Applied At</th>
              </tr>
            </thead>

            <tbody>
              <% if(usedCoupons.length > 0){ %>
                <% usedCoupons.forEach(u => { %>
                  <tr>
                    <td><%= u.id %></td>
                    <td><%= u.code %></td>
                    <td><%= u.title %></td>
                    <td><%= u.user_id %></td>
                    <td><%= u.discount_percent %>%</td>
                    <td><%= u.type == 1 ? "Services" : "Rides" %></td>
                    <td>
                      <span style="color:#28a745;font-weight:600;">Used</span>
                    </td>
                    <td><%= u.applied_at %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center">No Used Coupons</td>
                </tr>
              <% } %>
            </tbody>
          </table>

        </div>
      </div>
    </div>

  </section>
</div>











<!-- ADD COUPON MODAL -->
<div id="addCouponModal"
     style="
       display:none; position:fixed; top:0; left:0;
       width:100%; height:100%; background:rgba(0,0,0,0.6);
       justify-content:center; align-items:center; z-index:99999;
     ">

  <div style="
      background:#fff; padding:25px; width:420px;
      border-radius:4px; position:relative;
      box-shadow:0 0 25px rgba(0,0,0,0.3);
  ">

    <!-- CLOSE -->
    <span onclick="closeAddCouponModal()"
          style="position:absolute; right:15px; top:10px;
                 font-size:25px; cursor:pointer;">×</span>

    <h5 style="margin-bottom:20px;">Add New Coupon</h5>

    <form action="/coupon-add" method="POST">

  <label>Coupon Code</label>
<input type="text"
       name="code"
       id="couponCode"
       required
       maxlength="8"
       class="form-control"
       style="border-radius:0; margin-bottom:5px;">

<span id="codeError"
      style="color:red; font-size:13px; display:none;">
</span>

  <label>Title</label>
  <input type="text" name="title" required class="form-control"
         style="border-radius:0; margin-bottom:12px;">

  <label>Discount (%)</label>
  <input type="number" name="discount_percent" min="1" max="100" required
         class="form-control"
         style="border-radius:0; margin-bottom:12px;">

  <label>Expiry Date</label>
  <input type="datetime-local"
       name="expires_at"
       id="expiryDate"
       required
       class="form-control"
       style="border-radius:0; margin-bottom:18px;">


  <button class="btn btn-primary btn-sm"
          type="submit"
          style="border-radius:0; width:100%;">
    Add Coupon
  </button>

</form>

  </div>
</div>

<script src="/assets/bundles/sweetalert/sweetalert.min.js"></script>

<script>
function deleteCoupon(id){
  swal({
    title: "Are you sure?",
    text: "This coupon will be permanently deleted!",
    icon: "warning",
    buttons: true,
    dangerMode: true,
  }).then(ok => {
    if(ok){
      window.location.href = `/coupon-delete/${id}`;
    }
  });
}
</script>

<script>
function changeCouponStatus(id, newStatus, oldStatus){
  if(newStatus == oldStatus) return;

  const text =
    newStatus == 1
      ? "Activate this coupon?"
      : "Deactivate this coupon?";

  swal({
    title: "Are you sure?",
    text: text,
    icon: "warning",
    buttons: true,
    dangerMode: true,
  }).then(ok => {
    if(ok){
      window.location.href =
        `/coupon-status-update/${id}?status=${newStatus}`;
    } else {
      location.reload(); // revert dropdown
    }
  });
}
</script>





<script>
function openAddCouponModal(){
  document.getElementById("addCouponModal").style.display = "flex";
}
function closeAddCouponModal(){
  document.getElementById("addCouponModal").style.display = "none";
}
</script>


<script>
(function () {
  const input = document.getElementById("expiryDate");

  const now = new Date();
  now.setMinutes(now.getMinutes() - now.getTimezoneOffset()); 
  // IST / local timezone fix

  input.min = now.toISOString().slice(0,16);
})();
</script>


<script>
const codeInput = document.getElementById("couponCode");
const codeError = document.getElementById("codeError");

// auto uppercase + allow only A-Z & 0-9
codeInput.addEventListener("input", function () {
  this.value = this.value
    .toUpperCase()
    .replace(/[^A-Z0-9]/g, "");
});

// form submit validation
codeInput.closest("form").addEventListener("submit", function (e) {
  const val = codeInput.value.trim();

  if (val.length !== 8) {
    e.preventDefault();
    codeError.style.display = "block";
    codeError.innerText = "Coupon code must be exactly 8 characters (A–Z, 0–9)";
    codeInput.focus();
  } else {
    codeError.style.display = "none";
  }
});
</script>



<script>
document.getElementById("tableSearch").addEventListener("keyup", function(){
  let val = this.value.toLowerCase();
  document.querySelectorAll("table tbody tr").forEach(r => {
    r.style.display = r.innerText.toLowerCase().includes(val) ? "" : "none";
  });
});
</script>
