<style>
.table-bordered th,
.table-bordered td {
  border: 1px solid #dee2e6 !important;
}

.table thead th {
  background-color: #f8f9fa;
}

.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
</style>

<div class="main-content">

<div class="card-headers">
  <div class="row align-items-center mx-3 my-3">
    <div class="col-md-7">
      <div class="d-flex align-items-center gap-3">
        <h4 class="mb-0"><%= pageTitle %></h4>
      </div>
    </div>
  </div>
</div>

<div class="card-body p-0">
<div class="table-responsive">

<table class="table table-striped table-bordered">
<thead>
<tr>
  <th>ID</th>
  <th>Company Name</th>
  <th>GST Number</th>
  <th>GST %</th>
  <th>CGST %</th>
  <th>SGST %</th>
  <th>IGST %</th>
  <th>Booking Fee</th>
 
  <th>Action</th>
</tr>
</thead>

<tbody>

<% if (settings && settings.length > 0) { %>
<% settings.forEach(s => { %>

<tr>
  <td><%= s.id %></td>
  <td><%= s.company_name %></td>
  <td><%= s.gst_number %></td>
  <td><%= s.gst_percentage %></td>
  <td><%= s.cgst_percentage %></td>
  <td><%= s.sgst_percentage %></td>
  <td><%= s.igst_percentage %></td>
  <td><%= s.booking_fee %></td>
  

  <td>
    <button
      class="btn btn-success btn-sm"
      data-bs-toggle="modal"
      data-bs-target="#editModal_<%= s.id %>"
    >
      <i class="fa fa-edit"></i>
    </button>
  </td>
</tr>


<!-- =============== MODAL =============== -->

<div class="modal fade" id="editModal_<%= s.id %>">
<div class="modal-dialog modal-lg modal-dialog-centered">
<div class="modal-content">

<form method="POST" action="/invoice-settings/edit/<%= s.id %>">

<div class="modal-header bg-primary text-white">
  <h5>Edit Invoice Setting #<%= s.id %></h5>
  <button type="button" class="btn-close" data-bs-dismiss="modal">X</button>
</div>

<div class="modal-body">

<!-- ROW 1 -->
<div class="two-col mb-2">
  <div>
    <label>Company Name</label>
    <input
      name="company_name"
      class="form-control"
      value="<%= s.company_name || '' %>"
    />
  </div>

  <div>
    <label>GST %</label>
    <input
      name="gst_percentage"
      class="form-control"
      value="<%= s.gst_percentage || '' %>"
    />
  </div>
</div>


<!-- ROW 2 -->
<div class="two-col mb-2">
  <div>
    <label>CGST %</label>
    <input
      name="cgst_percentage"
      class="form-control"
      value="<%= s.cgst_percentage || '' %>"
    />
  </div>

  <div>
    <label>SGST %</label>
    <input
      name="sgst_percentage"
      class="form-control"
      value="<%= s.sgst_percentage || '' %>"
    />
  </div>
</div>


<!-- ROW 3 -->
<div class="two-col mb-2">
  <div>
    <label>IGST %</label>
    <input
      name="igst_percentage"
      class="form-control"
      value="<%= s.igst_percentage || '' %>"
    />
  </div>

  <div>
    <label>Booking Fee</label>
    <input
      name="booking_fee"
      class="form-control"
      value="<%= s.booking_fee || '' %>"
    />
  </div>
</div>


<div class="two-col mb-2">
  <div>
    <label>GST Number</label>
    <input
      name="gst_number"
      class="form-control"
      value="<%= s.gst_number || '' %>"
    />
  </div>
</div>




</div>

<div class="modal-footer">
  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
    Cancel
  </button>
  <button type="submit" class="btn btn-primary">
    Update
  </button>
</div>

</form>

</div>
</div>
</div>

<!-- ===================================== -->


<% }) %>
<% } else { %>

<tr>
  <td colspan="9" class="text-center text-muted py-3">
    No settings found.
  </td>
</tr>

<% } %>

</tbody>
</table>

</div>
</div>
</div>


<script>
document.getElementById("tableSearch")
.addEventListener("keyup", function () {

  const v = this.value.toLowerCase();
  const rows = document.querySelectorAll("tbody tr");

  rows.forEach(r => {
    const text = r.textContent.toLowerCase();
    r.style.display = text.includes(v) ? "" : "none";
  });

});
</script>
