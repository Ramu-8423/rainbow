<style>
th, td { 
  border: 1px solid #ddd; 
  padding: 8px; 
  text-align: center; 
  white-space: nowrap; 
  vertical-align: middle; 
}

/* PAGINATION STYLE */
.pagination-container {
  margin-top: 25px;
  padding: 12px 10px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #ddd;
  gap: 12px;
}

.pagination-left {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.pagination-left select {
  padding: 5px 8px;
  border-radius: 4px;
  border: 1px solid #ccc;
}

.pagination-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.pg-btn {
  padding: 6px 12px;
  border: 1px solid #0d6efd;
  color: #0d6efd;
  border-radius: 4px;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
}

.pg-btn.active,
.pg-btn:hover {
  background: #0d6efd;
  color: #fff;
}

.pg-input {
  width: 45px;
  text-align: center;
  padding: 5px;
  border: 1px solid #aaa;
  border-radius: 4px;
}

button,
.btn,
.form-control,
.form-select,
.dropdown-toggle,
.dropdown-menu {
  border-radius: 0 !important;
}

/* DROPDOWN */
.dropdown-menu {
  background-color: #000 !important;
  border: 1px solid #333 !important;
}

.dropdown-menu .dropdown-item {
  color: #fff !important;
}

.dropdown-menu .dropdown-item:hover {
  background-color: #222 !important;
}

.dropdown-menu .dropdown-item.active {
  background-color: #444 !important;
}

.dropdown-toggle {
  color: #28a745 !important;
  font-weight: bold;
  background-color: #fff !important;
  border: 1px solid #28a745 !important;
}
</style>

<div class="main-content">
  <section class="section">
    <div class="card">

      <!-- HEADER -->
      <div class="card-header">
        <div class="row align-items-center g-1">

          <div class="col-auto">
            <h6 class="mb-0">Service User Payments</h6>
          </div>

          <div class="col-auto">
            <input type="text" id="tableSearch"
                   placeholder="Search..."
                   class="form-control form-control-sm"
                   style="width:180px;">
          </div>

          <div class="col-auto">
            <input type="date"
                   value="<%= startDate || '' %>"
                   class="form-control form-control-sm">
          </div>

          <div class="col-auto">
            <input type="date"
                   value="<%= endDate || '' %>"
                   class="form-control form-control-sm">
          </div>

          <div class="col-auto d-flex gap-2">
            <button class="btn btn-primary btn-sm">Filter</button>
            <a href="/service_user_payments" class="btn btn-secondary btn-sm">Reset</a>
          </div>

        </div>
      </div>

      <!-- TABLE -->
      <div class="card-body">
        <div class="table-responsive">

          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>User ID</th>
                <th>User Name</th>
                <th>Mobile</th>
                <th>Amount</th>
                <th>Platform Fee</th>
                <th>Final Amount</th>
                <th>Payment Type</th>
                <th>Transaction ID</th>
                <th>Status</th>
                <th>Created At</th>
              </tr>
            </thead>

            <tbody>
              <% if (transactions.length > 0) { %>
                <% transactions.forEach(tx => { %>
                  <tr>
                    <td><%= tx.id %></td>
                    <td><%= tx.user_id %></td>

                    <td>
                      <%= tx.user_name || 'N/A' %>
                    </td>

                    <td>
                      <%= tx.user_mobile || '-' %>
                    </td>

                    <td>₹<%= Number(tx.amount || 0).toFixed(2) %></td>
                    <td><%= tx.platform_fee || '-' %></td>
                    <td>₹<%= Number(tx.final_amount || 0).toFixed(2) %></td>

                    <td>Self Wallet Add</td>

                    <td><%= tx.transaction_id || 'N/A' %></td>

                    <td>
                      <span class="badge
                        <%= tx.status == 1 ? 'bg-success' :
                            tx.status == 0 ? 'bg-warning text-dark' :
                            'bg-danger' %>">
                        <%= tx.status == 1 ? 'Success' :
                            tx.status == 0 ? 'Pending' :
                            'Failed' %>
                      </span>
                    </td>

                    <td><%= tx.created_at %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="11" class="text-center">No data found</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- PAGINATION -->
        <div class="pagination-container">

          <div class="pagination-left">
            <span>Items per page:</span>
            <select onchange="changePerPage(this.value)">
              <option value="10" <%= perPage==10?'selected':'' %>>10</option>
              <option value="15" <%= perPage==15?'selected':'' %>>15</option>
              <option value="20" <%= perPage==20?'selected':'' %>>20</option>
            </select>

            <span>
              <%= (page - 1) * perPage + 1 %> –
              <%= Math.min(page * perPage, total) %>
              of <%= total %>
            </span>
          </div>

          <div class="pagination-right">
            <a href="?page=1" class="pg-btn">«</a>
            <a href="?page=<%= page>1?page-1:1 %>" class="pg-btn">Previous</a>
            <input type="text" readonly value="<%= page %>" class="pg-input">
            <span>of <%= totalPages %></span>
            <a href="?page=<%= page<totalPages?page+1:totalPages %>" class="pg-btn">Next</a>
            <a href="?page=<%= totalPages %>" class="pg-btn">»</a>
          </div>

        </div>

      </div>
    </div>
  </section>
</div>

<script>
function changePerPage(val){
  const url = new URL(window.location.href);
  url.searchParams.set("perPage", val);
  url.searchParams.set("page", 1);
  window.location.href = url.toString();
}
</script>
