<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="main-content">

  <!-- Buttons -->
  <div class="col-12 mb-3">
    <button class="btn btn-primary me-2" onclick="showTab('list')">
      Zone List
    </button>
    <button class="btn btn-primary" onclick="showTab('create')">
      <%= editZone ? 'Edit Zone' : 'Create Zone' %>
    </button>
  </div>

  <!-- ================= LIST ================= -->
  <div id="zoneList"
       style="display:<%= activeTab === 'list' ? 'block' : 'none' %>">
    <div class="card p-3">
      <h4>Service Zone List</h4>

      <table class="table table-bordered">
        <thead>
          <tr>
            <th>ID</th>
            <th>Zone Name</th>
            <th>Created</th>
            <th width="120">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (zones.length) { %>
            <% zones.forEach(z => { %>
              <tr>
                <td><%= z.id %></td>
                <td><%= z.zone_name %></td>
                <td><%= new Date(z.created_at).toLocaleString() %></td>
                <td>
                  <a href="/service_zones/edit/<%= z.id %>"
                     class="btn btn-sm btn-warning">
                    Edit
                  </a>

                  <form id="del-<%= z.id %>"
                        action="/service_zones/delete/<%= z.id %>"
                        method="POST"
                        style="display:inline;">
                    <button type="button"
                            class="btn btn-sm btn-danger"
                            onclick="confirmDelete(<%= z.id %>)">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="text-center">
                No service zones found
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ================= CREATE / EDIT ================= -->
  <div id="createZone"
       style="display:<%= activeTab === 'create' ? 'block' : 'none' %>">
    <div class="card p-3">
      <h4><%= editZone ? 'Edit Service Zone' : 'Create Service Zone' %></h4>

      <form method="POST"
            action="<%= editZone ? '/service_zones/update/' + editZone.id : '/service_zones/create' %>">

        <div class="mb-3">
          <label class="fw-bold">Zone Name</label>
          <input type="text"
                 name="zone_name"
                 class="form-control"
                 required
                 value="<%= editZone ? editZone.zone_name : '' %>">
        </div>

        <div id="map"
             style="width:100%;height:400px;border-radius:10px"></div>

        <input type="hidden"
               id="coords"
               name="zone_coordinates"
               value='<%= editZone ? editZone.coordinates : "" %>'>

        <button class="btn btn-success mt-3">
          <%= editZone ? 'Update Zone' : 'Save Zone' %>
        </button>

        <% if (editZone) { %>
          <a href="/create_service_zone?tab=list"
             class="btn btn-secondary mt-3 ms-2">
            Cancel
          </a>
        <% } %>
      </form>
    </div>
  </div>

</div>

<script>
let map;
let drawingManager;
let polygon = null;
let mapReady = false;

/* 🔥 SAFE PARSE FOR EDIT */
let rawCoords = <%- JSON.stringify(editZone ? editZone.coordinates : null) %>;
let editCoords = [];

try {
  editCoords = rawCoords
    ? (typeof rawCoords === "string" ? JSON.parse(rawCoords) : rawCoords)
    : [];
} catch (e) {
  console.error("Invalid coordinates", e);
}

/* GOOGLE CALLBACK */
function initMap() {
  mapReady = true;
  if (document.getElementById("createZone").style.display !== "none") {
    loadMap();
  }
}

/* LOAD MAP ONLY WHEN TAB IS VISIBLE */
function loadMap() {
  if (!mapReady) return;

  map = new google.maps.Map(document.getElementById("map"), {
    center: editCoords.length
      ? editCoords[0]
      : { lat: 26.8467, lng: 80.9462 },
    zoom: 6,
    gestureHandling: "greedy"
  });

  drawingManager = new google.maps.drawing.DrawingManager({
    drawingMode: null,
    drawingControl: true,
    drawingControlOptions: {
      position: google.maps.ControlPosition.TOP_CENTER,
      drawingModes: [google.maps.drawing.OverlayType.POLYGON]
    },
    polygonOptions: {
      editable: true,
      fillColor: "#2563eb",
      fillOpacity: 0.35,
      strokeWeight: 2
    }
  });

  drawingManager.setMap(map);

  /* EXISTING ZONE (EDIT MODE) */
  if (editCoords.length) {
    polygon = new google.maps.Polygon({
      paths: editCoords,
      editable: true,
      map
    });
    bindPolygon(polygon);

    const bounds = new google.maps.LatLngBounds();
    editCoords.forEach(p => bounds.extend(p));
    map.fitBounds(bounds);
  }

  google.maps.event.addListener(
    drawingManager,
    "polygoncomplete",
    poly => {
      if (polygon) polygon.setMap(null);
      polygon = poly;
      bindPolygon(poly);
    }
  );
}

/* BIND EVENTS */
function bindPolygon(poly) {
  google.maps.event.addListener(poly.getPath(), "set_at", saveCoords);
  google.maps.event.addListener(poly.getPath(), "insert_at", saveCoords);
  saveCoords();
}

function saveCoords() {
  const coords = polygon.getPath().getArray().map(p => ({
    lat: p.lat(),
    lng: p.lng()
  }));
  document.getElementById("coords").value =
    JSON.stringify(coords);
}

/* TAB SWITCH */
function showTab(tab) {
  zoneList.style.display = tab === "list" ? "block" : "none";
  createZone.style.display = tab === "create" ? "block" : "none";

  if (tab === "create") {
    setTimeout(loadMap, 300);
  }
}

/* DELETE CONFIRM */
function confirmDelete(id) {
  Swal.fire({
    title: "Are you sure?",
    icon: "warning",
    showCancelButton: true
  }).then(r => {
    if (r.isConfirmed) {
      document.getElementById("del-" + id).submit();
    }
  });
}
</script>

<!-- 🔥 DRAWING LIBRARY (MANDATORY) -->
<script async
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCm7ErTUTWLiTIT9KvG9bziUokOEt5wCBI&libraries=drawing&callback=initMap">
</script>
