<style>
  .file-box {
    width: 50px;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f1f1;
    margin-right: 6px;
    cursor: pointer;
    vertical-align: middle;
  }

  .file-box img {
    display: block;
  }

  .file-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ===========================
     RESPONSIVE PAGINATION
  =========================== */

  .pagination-container {
    margin-top: 25px;
    padding: 12px 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #ddd;
    gap: 12px;
  }

  .pagination-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pagination-left select {
    padding: 5px 8px;
    border-radius: 4px;
    border: 1px solid #ccc;
  }

  .pagination-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pg-btn {
    padding: 6px 12px;
    border: 1px solid #007bff;
    color: #007bff;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .pg-btn:hover {
    background: #007bff;
    color: #fff;
  }

  .pg-input {
    width: 45px;
    text-align: center;
    padding: 5px;
    border: 1px solid #aaa;
    border-radius: 4px;
  }

  /* MOBILE */
  @media(max-width: 600px){
    .pagination-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .pagination-right,
    .pagination-left {
      width: 100%;
      justify-content: space-between;
    }
  }

  /* FILTER + HEADER */
  .card-header {
    gap: 10px;
  }

  .filter-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start !important;
    }

    #tableSearch {
      width: 100% !important;
      margin: 0 !important;
    }

    .filter-form input {
      width: 48% !important;
    }

    .filter-form button,
    .filter-form a {
      width: 100%;
    }
  }

  .card-header .form-control {
    border-radius: 0 !important;
  }
</style>




<div class="main-content">
  <section class="section">

    <div class="card">

   <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">

  <!-- LEFT -->
  <h4 class="mb-0">Users List</h4>

  <!-- CENTER : STATUS -->
  <div class="d-flex gap-2">
    <a href="/all-users"
       class="btn btn-sm <%= !status ? 'btn-primary' : 'btn-secondary' %>"
       style="border-radius:0;">All</a>

    <a href="/all-users?status=1"
       class="btn btn-sm <%= status == 1 ? 'btn-primary' : 'btn-secondary' %>"
       style="border-radius:0;">Active</a>

    <a href="/all-users?status=0"
       class="btn btn-sm <%= status == 0 ? 'btn-primary' : 'btn-secondary' %>"
       style="border-radius:0;">Inactive</a>
  </div>

  <!-- RIGHT : SEARCH + DATE + FILTER -->
  <form method="GET" class="filter-form d-flex align-items-center gap-2 flex-wrap">

    <!-- SEARCH -->
    <input
      type="text"
      name="search"
      value="<%= search || '' %>"
      placeholder="Search name / mobile"
      class="form-control"
      style="width:200px;"
    />

    <!-- DATE -->
    <input type="date" name="from" value="<%= from || '' %>" class="form-control" style="width:140px;" />
    <input type="date" name="to" value="<%= to || '' %>" class="form-control" style="width:140px;" />

    <!-- STATUS PRESERVE -->
    <% if (status !== undefined && status !== "") { %>
      <input type="hidden" name="status" value="<%= status %>">
    <% } %>

    <button type="submit" class="btn btn-primary btn-sm" style="border-radius:0;">
      Filter
    </button>

    <% if (search || isFiltered) { %>
      <a href="/all-users" class="btn btn-secondary btn-sm" style="border-radius:0;">
        Reset
      </a>
    <% } %>

  </form>



</div>



      <!-- TABLE -->
      <div class="card-body">
        <div class="table-responsive">

          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
              
                <th>Phone</th>
                <th>City</th>
                <th>Status</th>
                <th>Image</th>
                <th>City</th>
                <th>Date</th>
              </tr>
            </thead>

            <tbody>
              <% if(users.length > 0) { %>

                <% users.forEach(u => { %>
                  <tr>
                    <td><%= u.id %></td>
                    <td><%= u.name %> <%= u.last_name || '' %></td>
                    <td><%= u.phone %></td>
                    <td><%= u.city %></td>
                    
   <td style="white-space:nowrap;">
  <select 
    class="status-select"
    data-status="<%= u.status %>"
    onchange="changeStatus('<%= u.id %>', this.value)"
    style="
      width:110px;
      padding:3px 6px;
      font-size:13px;
      border-radius:3px;
      cursor:pointer;
      border:1px solid <%= u.status == 1 ? '#28a745' : '#dc3545' %>;
      color:<%= u.status == 1 ? '#28a745' : '#dc3545' %>;
      font-weight:600;
      vertical-align:middle;
    "
  >
    <option value="1" style="color:green; font-weight:600;"
      <%= u.status == 1 ? 'selected' : '' %>>
      Active
    </option>

    <option value="0" style="color:red; font-weight:600;"
      <%= u.status == 0 ? 'selected' : '' %>>
      Inactive
    </option>
  </select>

  <% if (u.status == 0 && u.reason) { 
       const words = u.reason.split(" ");
  %>
    <div style="
      margin-top:4px;
      font-size:11px;
      color:#dc3545;
      font-weight:500;
      white-space:normal;
    ">
      Reason:
      <span>
        <% for (let i = 0; i < words.length; i++) { %>
          <%= words[i] %>
          <% if ((i + 1) % 10 === 0 && i !== words.length - 1) { %>
            <br>
          <% } else { %>
            &nbsp;
          <% } %>
        <% } %>
      </span>
    </div>
  <% } %>
</td>



                    <td>
                      <% if (u.image) { %>
                        <div class="file-box">
                          <img src="/<%= u.image %>" onclick="openImageModal('/<%= u.image %>')" class="file-thumb">
                        </div>
                      <% } else { %> — <% } %>
                    </td>

                    <td><%= u.city || '-' %></td>
                    <td><%= u.created_at %></td>
                  </tr>
                <% }) %>

              <% } else { %>
                <tr><td colspan="8" class="text-center">No users found</td></tr>
              <% } %>
            </tbody>

          </table>
        </div>




        <!-- ⭐ UPDATED PAGINATION (dynamic dropdown) -->
       <% 
  function buildQuery(pageNumber) {
    let q = `?page=${pageNumber}&perPage=${perPage}`;

    if (status !== undefined && status !== "") {
      q += `&status=${status}`;
    }
    if (from) q += `&from=${from}`;
    if (to) q += `&to=${to}`;

    return q;
  }
%>

<div class="pagination-container">

  <div class="pagination-left">
    <span>Items per page:</span>

    <select onchange="changePerPage(this.value)">
      <option value="8"  <%= perPage == 8 ? 'selected' : '' %>>8</option>
      <option value="10" <%= perPage == 10 ? 'selected' : '' %>>10</option>
      <option value="15" <%= perPage == 15 ? 'selected' : '' %>>15</option>
      <option value="20" <%= perPage == 20 ? 'selected' : '' %>>20</option>
    </select>

    <span>
      <%= (page - 1) * perPage + 1 %> –
      <%= Math.min(page * perPage, total) %>
      of <%= total %> items
    </span>
  </div>


  <div class="pagination-right">

    <a href="<%= buildQuery(1) %>" class="pg-btn">&laquo;</a>

    <a href="<%= buildQuery(page > 1 ? page - 1 : 1) %>" class="pg-btn">Previous</a>

    <input type="text" readonly value="<%= page %>" class="pg-input">
    <span>of <%= totalPages %></span>

    <a href="<%= buildQuery(page < totalPages ? page + 1 : totalPages) %>" class="pg-btn">Next</a>

    <a href="<%= buildQuery(totalPages) %>" class="pg-btn">&raquo;</a>

  </div>

</div>



      </div>
    </div>

  </section>
</div>





<!-- IMAGE MODAL -->
<div id="imageModal" style="
  display:none; position:fixed;
  top:0; left:0; width:100%; height:100%;
  background:rgba(0,0,0,0.7);
  justify-content:center; align-items:center;
  z-index:9999;
">
  <span onclick="closeModal()" style="position:absolute; top:20px; right:30px; font-size:35px; color:white; cursor:pointer;">&times;</span>
  <img id="modalImage" style="max-width:80%; max-height:80%; border-radius:10px;">
</div>



<script>
function openImageModal(src){
  document.getElementById("modalImage").src = src;
  document.getElementById("imageModal").style.display = "flex";
}
function closeModal(){
  document.getElementById("imageModal").style.display = "none";
}

function changePerPage(val){
  const url = new URL(window.location.href);
  url.searchParams.set("perPage", val);
  url.searchParams.set("page", 1);
  window.location.href = url.toString();
}
</script>


<script>
document.getElementById("tableSearch").addEventListener("keyup", function(){
  let value = this.value.toLowerCase();
  let rows = document.querySelectorAll("table tbody tr");

  rows.forEach(row => {
    let text = row.innerText.toLowerCase();
    row.style.display = text.includes(value) ? "" : "none";
  });
});
</script>




<script>
function changeStatus(id, newStatus){

  let text = newStatus == 1 
      ? "You want to activate this user?"
      : "You want to deactivate this user?";

  swal({
    title: "Are you sure?",
    text: text,
    icon: "warning",
    buttons: true,
    dangerMode: true,
  }).then((ok) => {

    if (!ok) {
      // Refresh page to revert dropdown selection
      location.reload();
      return;
    }

    // If deactivating → ask for reason
    if (newStatus == 0) {
      swal({
        title: "Reason Required",
        text: "Please enter reason:",
        content: "input",
        buttons: true
      }).then((reason) => {

        if (!reason) {
          swal("Reason is required!", { icon: "error" });
          location.reload();
          return;
        }

        // Send to backend
        window.location.href = `/user-status-update/${id}?status=0&reason=${encodeURIComponent(reason)}`;
      });
    } 
    else {
      // Activate directly
      window.location.href = `/user-status-update/${id}?status=1`;
    }

  });
}
</script>
<script src="assets/bundles/sweetalert/sweetalert.min.js"></script>
<script src="assets/js/page/sweetalert.js"></script>

