<style>
  .file-box {
    width: 50px;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f1f1;
    margin-right: 6px;
    cursor: pointer;
    vertical-align: middle;
  }

  .file-box img {
    display: block;
  }

  .file-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdf-icon {
    font-size: 26px;
    color: #dc3545;
  }

  .pdf-icon:hover {
    color: #9b1c27;
  }


/* ===========================
     RESPONSIVE PAGINATION
=========================== */

.pagination-container {
  margin-top: 25px;
  padding: 12px 10px;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #ddd;
  gap: 12px;
}

.pagination-left {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.pagination-left select {
  padding: 5px 8px;
  border-radius: 4px;
  border: 1px solid #ccc;
}

.pagination-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.pg-btn {
  padding: 6px 12px;
  border: 1px solid #007bff;
  color: #007bff;
  border-radius: 4px;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
}

.pg-btn:hover {
  background: #007bff;
  color: #fff;
}

.pg-input {
  width: 45px;
  text-align: center;
  padding: 5px;
  border: 1px solid #aaa;
  border-radius: 4px;
}

/* MOBILE: stack layout clean */
@media(max-width: 600px){
  .pagination-container {
    flex-direction: column;
    align-items: flex-start;
  }

  .pagination-right {
    width: 100%;
    justify-content: space-between;
  }

  .pagination-left {
    width: 100%;
    justify-content: space-between;
  }
}
</style>



<style>
  .card-header {
    gap: 10px;
  }

  .filter-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* Mobile View Fix */
  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start !important;
    }

    #tableSearch {
      width: 100% !important;
      margin: 0 !important;
    }

    .filter-form {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }

    .filter-form input {
      width: 48% !important;   /* Side by side on mobile */
    }

    .filter-form button,
    .filter-form a {
      width: 100%;  /* Buttons full width on mobile */
    }
  }
  
    .card-header .form-control {
    border-radius: 0 !important;
  }
</style>



<div class="main-content">
  <section class="section">

    <div class="card">

<div class="card-header d-flex justify-content-between align-items-center flex-wrap">

  <h4 class="mb-0">Job Applications</h4>

  <!-- SEARCH -->
  <input 
    type="text"
    id="tableSearch"
    placeholder="Search..."
    class="form-control mx-3"
    style="width:220px;"
  />

  <!-- FILTER FORM -->
  <form class="filter-form d-flex align-items-center gap-2" method="GET">

    <input 
      type="date" 
      name="from"
      value="<%= from || '' %>"
      class="form-control"
      style="width:150px;"
    />

    <input 
      type="date" 
      name="to"
      value="<%= to || '' %>"
      class="form-control"
      style="width:150px;"
    />

    <!-- FILTER always visible -->
    
   <button type="submit" 
  class="btn btn-primary btn-sm"
  style="border-radius:0;">
  Filter
</button>

<% if (isFiltered) { %>
  <a href="/job-applications"
     class="btn btn-secondary btn-sm"
     style="border-radius:0;">
    Reset
  </a>
<% } %>


  </form>

</div>


      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Designation</th>
                <th>Profile Photo</th>
                <th>Police Certificate</th>
                <th>Designation Files</th>
                <th>Date</th>
              
              </tr>
            </thead>

            <tbody>
              <% if(jobs.length > 0) { %>

                <% jobs.forEach(job => { %>
                  <tr>
                    <td><%= job.id %></td>
                    <td><%= job.first_name %> <%= job.last_name %></td>
                    <td><%= job.email %></td>
                    <td><%= job.mobile %></td>
                    <td><%= job.designation %></td>

                    <!-- PROFILE PHOTO -->
                    <td>
                      <% const ext1 = job.profile_photo?.split('.').pop().toLowerCase(); %>
                      <% if(job.profile_photo){ %>

                        <div class="file-box">
                          <% if(ext1 === 'pdf'){ %>
                            <i class="bi bi-filetype-pdf pdf-icon" onclick="window.open('/<%= job.profile_photo %>', '_blank')"></i>
                          <% }else{ %>
                            <img src="/<%= job.profile_photo %>" onclick="openImageModal('/<%= job.profile_photo %>')" class="file-thumb">
                          <% } %>
                        </div>

                      <% } else { %> — <% } %>
                    </td>


                    <!-- POLICE CERTIFICATE -->
                    <td>
                      <% const ext2 = job.police_verification_certificate?.split('.').pop().toLowerCase(); %>
                      <% if(job.police_verification_certificate){ %>

                        <div class="file-box">
                          <% if(ext2 === 'pdf'){ %>
                            <i class="bi bi-filetype-pdf pdf-icon" onclick="window.open('/<%= job.police_verification_certificate %>', '_blank')"></i>
                          <% }else{ %>
                            <img src="/<%= job.police_verification_certificate %>" onclick="openImageModal('/<%= job.police_verification_certificate %>')" class="file-thumb">
                          <% } %>
                        </div>

                      <% } else { %> — <% } %>
                    </td>


                    <!-- DESIGNATION FILES -->
                    <td>
                      <% let files = []; try{ files = JSON.parse(job.designation_file || "[]"); }catch(e){} %>

                      <% if(files.length > 0){ %>
                        <% files.forEach(file => { 
                            const ext = file.split('.').pop().toLowerCase();
                        %>

                          <div class="file-box">
                            <% if(ext === "pdf"){ %>
                              <i class="bi bi-filetype-pdf pdf-icon" onclick="window.open('/<%= file %>', '_blank')"></i>
                            <% } else { %>
                              <img src="/<%= file %>" onclick="openImageModal('/<%= file %>')" class="file-thumb">
                            <% } %>
                          </div>

                        <% }) %>
                      <% } else { %> — <% } %>
                    </td>

                    <td><%= job.created_at %></td>

                  </tr>
                <% }) %>

              <% } else { %>
                <tr><td colspan="10" class="text-center">No job applications found</td></tr>
              <% } %>
            </tbody>

          </table>
        </div>


        <!-- PAGINATION UI -->
        <div class="pagination-container">

          <div class="pagination-left">
            <span>Items per page:</span>
            <select onchange="changePerPage(this.value)">
              <option value="8" selected>8</option>
            </select>

            <span>
              <%= (page - 1) * perPage + 1 %> –
              <%= Math.min(page * perPage, total) %>
              of <%= total %> items
            </span>
          </div>

          <div class="pagination-right">
            <a href="?page=1" class="pg-btn">&laquo;</a>
            <a href="?page=<%= page > 1 ? page - 1 : 1 %>" class="pg-btn">Previous</a>

            <input type="text" readonly value="<%= page %>" class="pg-input">
            <span>of <%= totalPages %></span>

            <a href="?page=<%= page < totalPages ? page + 1 : totalPages %>" class="pg-btn">Next</a>
            <a href="?page=<%= totalPages %>" class="pg-btn">&raquo;</a>
          </div>

        </div>
        <!-- END PAGINATION -->

      </div>
    </div>

  </section>
</div>


<!-- IMAGE PREVIEW MODAL -->
<div id="imageModal" style="
  display:none; position:fixed;
  top:0; left:0; width:100%; height:100%;
  background:rgba(0,0,0,0.7);
  justify-content:center; align-items:center;
  z-index:9999;
">
  <span onclick="closeModal()" style="position:absolute; top:20px; right:30px; font-size:35px; color:white; cursor:pointer;">&times;</span>
  <img id="modalImage" style="max-width:80%; max-height:80%; border-radius:10px;">
</div>

<script>
function openImageModal(src){
  document.getElementById("modalImage").src = src;
  document.getElementById("imageModal").style.display = "flex";
}

function closeModal(){
  document.getElementById("imageModal").style.display = "none";
}

function changePerPage(val){
  window.location.href = "?page=1&perPage="+val;
}
</script>

<script>
document.getElementById("tableSearch").addEventListener("keyup", function () {
  let value = this.value.toLowerCase();
  let rows = document.querySelectorAll("table tbody tr");

  rows.forEach(row => {
    let text = row.innerText.toLowerCase();
    row.style.display = text.includes(value) ? "" : "none";
  });
});
</script>

