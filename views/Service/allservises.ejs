 <script>
function openEditServiceModal(service) {
  document.getElementById("edit_service_id").value = service.id;
  document.getElementById("edit_title").value = service.title || "";
  document.getElementById("edit_price").value = service.price || "";
  document.getElementById("edit_description").value = service.description || "";
  document.getElementById("edit_status").value = service.status;
  document.getElementById("edit_old_image").value = service.service_image || "";

  const img = document.getElementById("editImgPreview");
  if (service.service_image) {
    img.src = "/" + service.service_image;
    img.classList.remove("d-none");
  } else {
    img.classList.add("d-none");
  }

  // RESET FAQS
  const faqBox = document.getElementById("editFaqContainer");
  faqBox.innerHTML = "";

  let faqs = [];
  try {
    faqs = JSON.parse(service.faqs);
  } catch {}

  if (Array.isArray(faqs)) {
    faqs.forEach(f => addEditFaq(f.question || "", f.answer || ""));
  }

  new bootstrap.Modal(
    document.getElementById("editServiceModal")
  ).show();
}

function addEditFaq(q = "", a = "") {
  const box = document.createElement("div");
  box.className = "border p-2 mb-2 position-relative";

  box.innerHTML = `
    <button type="button"
      class="position-absolute end-0 top-0"
      style="border:none;background:transparent"
      onclick="this.parentElement.remove()">
      <i class="fa fa-times"></i>
    </button>

    <input
      type="text"
      class="form-control mb-1"
      placeholder="Question"
      name="faq_q[]"
      value="${q}"
    >

    <textarea
      class="form-control"
      placeholder="Answer"
      name="faq_a[]"
    >${a}</textarea>
  `;

  document.getElementById("editFaqContainer").appendChild(box);
}

function previewEditImage(input) {
  const file = input.files[0];
  if (!file) return;

  document.getElementById("editImgPreview").src =
    URL.createObjectURL(file);

  document.getElementById("editImgPreview")
    .classList.remove("d-none");

  document.getElementById("editImgName").innerText = file.name;
}

// 🔥 IMPORTANT: BUILD FAQs JSON ON SUBMIT
document.getElementById("editServiceForm")
  .addEventListener("submit", function () {

    const qs = document.querySelectorAll(
      '#editFaqContainer input[name="faq_q[]"]'
    );
    const as = document.querySelectorAll(
      '#editFaqContainer textarea[name="faq_a[]"]'
    );

    const faqs = [];

    qs.forEach((q, i) => {
      if (q.value.trim() && as[i] && as[i].value.trim()) {
        faqs.push({
          id: i + 1,
          question: q.value.trim(),
          answer: as[i].value.trim()
        });
      }
    });

    document.getElementById("editFaqsInput").value =
      JSON.stringify(faqs);
});
</script>

