<script>
const form = document.getElementById("addServiceForm");

const fields = {
  category: {
    el: document.getElementById("categorySelect"),
    err: document.getElementById("err_category")
  },
  subcategory: {
    el: document.getElementById("subcategorySelect"),
    err: document.getElementById("err_subcategory")
  },
  title: {
    el: document.getElementById("titleInput"),
    err: document.getElementById("err_title")
  },
  price: {
    el: document.getElementById("priceInput"),
    err: document.getElementById("err_price")
  },
  image: {
    el: document.getElementById("imageInput"),
    err: document.getElementById("err_image")
  }
};

// 🔴 show error
function showError(key) {
  fields[key].err.classList.remove("d-none");
}

// 🟢 hide error
function hideError(key) {
  fields[key].err.classList.add("d-none");
}

// 🔁 realtime validation remove
Object.keys(fields).forEach(key => {
  fields[key].el.addEventListener("change", () => {
    if (
      fields[key].el.value ||
      (fields[key].el.files && fields[key].el.files.length)
    ) {
      hideError(key);
    }
  });

  fields[key].el.addEventListener("keyup", () => {
    if (fields[key].el.value) {
      hideError(key);
    }
  });
});

// ⛔ submit block until valid
form.addEventListener("submit", function (e) {
  let valid = true;

  if (!fields.category.el.value) {
    showError("category");
    valid = false;
  }

  if (!fields.subcategory.el.value) {
    showError("subcategory");
    valid = false;
  }

  if (!fields.title.el.value.trim()) {
    showError("title");
    valid = false;
  }

  if (!fields.price.el.value) {
    showError("price");
    valid = false;
  }

  if (!fields.image.el.files.length) {
    showError("image");
    valid = false;
  }

  // FAQs JSON build
  const qs = document.querySelectorAll('input[name="faq_q[]"]');
  const as = document.querySelectorAll('textarea[name="faq_a[]"]');

  const faqs = [];
  qs.forEach((q, i) => {
    if (q.value.trim() && as[i].value.trim()) {
      faqs.push({
        id: i + 1,
        question: q.value.trim(),
        answer: as[i].value.trim()
      });
    }
  });

  document.getElementById("faqsInput").value =
    JSON.stringify(faqs);

  if (!valid) {
    e.preventDefault(); // 🚫 STOP submit
  }
});

// FAQ add/remove
function addFaq(q = "", a = "") {
  const box = document.createElement("div");
  box.className = "border p-2 mb-2 position-relative";

  box.innerHTML = `
   <button
  type="button"
  class="position-absolute end-0 top-0"
  style="border:none; background:transparent; box-shadow:none;"
  onclick="this.parentElement.remove()"
>
  <i class="fa fa-times"></i>
</button>


    <input type="text"
      class="form-control mb-1"
      placeholder="Question"
      name="faq_q[]"
      value="${q}">

    <textarea class="form-control"
      placeholder="Answer"
      name="faq_a[]">${a}</textarea>
  `;

  document.getElementById("faqContainer").appendChild(box);
}

// Image preview
function previewImage(input) {
  const file = input.files[0];
  if (!file) return;

  document.getElementById("imgPreview").src =
    URL.createObjectURL(file);

  document.getElementById("imgPreview").classList.remove("d-none");
  document.getElementById("imgName").innerText = file.name;
}
</script>




