<script>
document.getElementById("categorySelect").addEventListener("change", function () {
  const categoryId = this.value;
  const subSelect = document.getElementById("subcategorySelect");

  subSelect.innerHTML = `<option value="">Loading...</option>`;

  fetch(`/ajax/subcategories/${categoryId}`)
    .then(res => res.json())
    .then(data => {
      subSelect.innerHTML = `<option value="">Select Sub Category</option>`;
      data.forEach(sc => {
        subSelect.innerHTML += `<option value="${sc.id}">${sc.name}</option>`;
      });
    });
});
</script>




<script src="/assets/bundles/sweetalert/sweetalert.min.js"></script>

<script>
function changeServiceStatus(id, el) {
  const newStatus = el.value;
  const oldStatus = el.getAttribute("data-old");

  const text =
    newStatus == 1
      ? "Activate this service?"
      : "Deactivate this service?";

  swal({
    title: "Are you sure?",
    text: text,
    icon: "warning",
    buttons: true,
    dangerMode: true,
  }).then((ok) => {

    if (!ok) {
      el.value = oldStatus; // revert dropdown
      return;
    }

    window.location.href =
      `/service-status-update/${id}?status=${newStatus}`;
  });
}
</script>




<script>
function deleteService(id, status) {

  swal({
    title: "Are you sure?",
    text: "This service will be permanently deleted!",
    icon: "warning",
    buttons: true,
    dangerMode: true,
  }).then((ok) => {

    if (!ok) return;

    window.location.href =
      `/service-delete/${id}?status=${status}`;
  });
}
</script>

