<script>
(function () {

  // 1. Dashboard ko current history me replace karo
  history.replaceState({ page: "dashboard" }, "", location.href);

  // 2. Extra fake state push
  history.pushState({ page: "dashboard" }, "", location.href);

  // 3. Back dabane par turant wapas lao
  window.addEventListener("popstate", function () {
    location.replace(location.href);
  });

  // 4. Tab switch / minimize / back cache detect
  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "visible") {
      history.pushState({ page: "dashboard" }, "", location.href);
    }
  });

  // 5. Page restore (Chrome bfcache killer)
  window.addEventListener("pageshow", function (e) {
    if (e.persisted) {
      location.replace(location.href);
    }
  });

})();
</script>






<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>


<script>
/* =====================================================
   🔥 Firebase Init (PUBLIC CONFIG ONLY)
===================================================== */
const firebaseConfig = {
  apiKey: "YOUR_API_KEY",
  authDomain: "rainbow-f0f87.firebaseapp.com",
  projectId: "rainbow-f0f87",
};

if (!firebase.apps.length) {
  firebase.initializeApp(firebaseConfig);
}

const db = firebase.firestore();
const activeRideEl = document.getElementById("activeRideCount");

/* =====================================================
   🔥 LIVE ACTIVE RIDE COUNT
   order_status BETWEEN 1 AND 4
===================================================== */
db.collection("cab_orders")
  .where("order_status", ">", 0)
  .where("order_status", "<", 5)
  .onSnapshot(snapshot => {

    activeRideEl.textContent = snapshot.size;

  }, error => {
    console.error("Active Ride Count Error:", error);
  });
</script>
