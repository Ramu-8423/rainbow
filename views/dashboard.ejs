<div class="main-content">

<style>
 .mini-card {
  background: #ffffff;
  border-radius: 5px;
  padding: 12px 14px;
  height: 90px;
  box-shadow:
    0 1px 3px rgba(255, 255, 255, 0.9),
    0 2px 6px rgba(0, 0, 0, 0.08);
  cursor: pointer;
  transition: all 0.3s ease;
}

.mini-card:hover {
  transform: translateY(-3px);
  box-shadow:
    0 4px 6px rgba(0, 0, 0, 0.1),
    0 2px 4px rgba(0, 0, 0, 0.06);
}

.mini-card-title {
  font-size: 14px;
  color: black;
  margin-bottom: 6px;
  font-weight: 600;
}

.mini-card-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mini-icon {
  width: 36px;
  height: 36px;
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

.icon-green { background:#dcfce7; color:#16a34a; }
.icon-purple { background:#ede9fe; color:#7c3aed; }
.icon-blue { background:#e0f2fe; color:#0284c7; }
.icon-red { background:#fee2e2; color:#dc2626; }
.icon-orange { background:#ffedd5; color:#ea580c; }
.icon-dark { background:#e5e7eb; color:#111827; }

.mini-badge {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 20px;
  font-weight: 600;
}

.badge-green { background:#dcfce7; color:#16a34a; }
.badge-red { background:#fee2e2; color:#dc2626; }
.badge-purple { background:#ede9fe; color:#7c3aed; }
.badge-blue { background:#e0f2fe; color:#0284c7; }
.badge-orange { background:#ffedd5; color:#ea580c; }
.badge-dark { background:#e5e7eb; color:#111827; }


.btn-double {
  min-width: 120px important;  
  text-align: center important;
}
</style>

<!-- ================= MAIN DASHBOARD ROW ================= -->

<form method="GET" action="/dashboard" class="row g-2 align-items-end mb-3">

  <!-- FROM DATE -->
  <div class="col-sm-3">
    <label class="form-label form-label-sm mb-1">From Date</label>
    <input
      type="date"
      name="from"
      class="form-control form-control-sm"
      value="<%= from || '' %>"
      required
    >
  </div>

  <!-- TO DATE -->
  <div class="col-sm-3">
    <label class="form-label form-label-sm mb-1">To Date</label>
    <input
      type="date"
      name="to"
      class="form-control form-control-sm"
      value="<%= to || '' %>"
      required
    >
  </div>

  <!-- BUTTONS -->
  <div class="col-sm-3 d-flex gap-1">
    <button type="submit" class="btn btn-sm btn-primary w-100">
      Filter
    </button>
    <a href="/dashboard" class="btn btn-sm btn-secondary w-100">
      Reset
    </a>
  </div>

  <!-- EMPTY SPACE (RIGHT SIDE) -->
  <div class="col-sm-4"></div>

</form>



<div class="row">

  <div class="col-12 mb-2">
    <h4 class="mt-2">Revenue Overview</h4>
  </div>

 <!-- 🔥 REVENUE SUMMARY -->
<div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 mb-3">

  <%
    const totalRevenue =
      Number(service_revenue || 0) +
      Number(cab_revenue || 0);

    const gstAmount = (totalRevenue * 18) / 118;
    const actualRevenue = totalRevenue - gstAmount;
  %>

  <div class="mini-card" style="height:auto;padding:14px;">

    <div class="mini-card-title mb-2">
      Revenue Summary
    </div>

    <!-- INNER FLEX -->
    <div style="
        display:flex;
        gap:8px;
        justify-content:space-between;
    ">

      <!-- TOTAL -->
      <div style="
          flex:1;
          background:#e0ecff;
          border-radius:6px;
          padding:8px;
          text-align:center;
      ">
        <div style="font-size:11px;color:#555;">Total</div>
        <div style="font-weight:700;color:#0d6efd;">
          ₹ <%= totalRevenue.toFixed(2) %>
        </div>
      </div>

      <!-- GST -->
      <div style="
          flex:1;
          background:#ffe3e3;
          border-radius:6px;
          padding:8px;
          text-align:center;
      ">
        <div style="font-size:11px;color:#555;">GST</div>
        <div style="font-weight:700;color:#dc2626;">
          ₹ <%= gstAmount.toFixed(2) %>
        </div>
      </div>

      <!-- NET -->
      <div style="
          flex:1;
          background:#dcfce7;
          border-radius:6px;
          padding:8px;
          text-align:center;
      ">
        <div style="font-size:11px;color:#555;">Net</div>
        <div style="font-weight:700;color:#16a34a;">
          ₹ <%= actualRevenue.toFixed(2) %>
        </div>
      </div>

    </div>

  </div>
</div>

  <!-- 🔥 TODAY TOTAL REVENUE -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 mb-3">
    <div class="mini-card">
      <div class="mini-card-title">Today Total Revenue</div>
      <div class="mini-card-body">
        <div class="mini-icon icon-purple"><i class="bi bi-cash-stack"></i></div>
        <span class="mini-badge badge-purple">
          <%= (Number(today_service_revenue || 0) + Number(today_cab_revenue || 0)).toFixed(2) %>
        </span>
      </div>
    </div>
  </div>

  <!-- 🟢 TOTAL SERVICE REVENUE -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 mb-3">
    <div class="mini-card">
      <div class="mini-card-title">Total Service Revenue</div>
      <div class="mini-card-body">
        <div class="mini-icon icon-green"><i class="bi bi-tools"></i></div>
        <span class="mini-badge badge-green">
          <%= Number(service_revenue || 0).toFixed(2) %>
        </span>
      </div>
    </div>
  </div>

  <!-- 🟢 TODAY SERVICE REVENUE -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 mb-3">
    <div class="mini-card">
      <div class="mini-card-title">Today Service Revenue</div>
      <div class="mini-card-body">
        <div class="mini-icon icon-purple"><i class="bi bi-tools"></i></div>
        <span class="mini-badge badge-purple">
          <%= Number(today_service_revenue || 0).toFixed(2) %>
        </span>
      </div>
    </div>
  </div>

  <!-- 🚕 TOTAL CAB REVENUE -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 mb-3">
    <div class="mini-card">
      <div class="mini-card-title">Total Ride Revenue</div>
      <div class="mini-card-body">
        <div class="mini-icon icon-green"><i class="bi bi-car-front-fill"></i></div>
        <span class="mini-badge badge-green">
          <%= Number(cab_revenue || 0).toFixed(2) %>
        </span>
      </div>
    </div>
  </div>

  <!-- 🚕 TODAY CAB REVENUE -->
  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-6 mb-3">
    <div class="mini-card">
      <div class="mini-card-title">Today Ride Revenue</div>
      <div class="mini-card-body">
