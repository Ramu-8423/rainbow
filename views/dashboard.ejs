<script>
(function () {

  // 1. Dashboard ko current history me replace karo
  history.replaceState({ page: "dashboard" }, "", location.href);

  // 2. Extra fake state push
  history.pushState({ page: "dashboard" }, "", location.href);

  // 3. Back dabane par turant wapas lao
  window.addEventListener("popstate", function () {
    location.replace(location.href);
  });

  // 4. Tab switch / minimize / back cache detect
  document.addEventListener("visibilitychange", function () {
    if (document.visibilityState === "visible") {
      history.pushState({ page: "dashboard" }, "", location.href);
    }
  });

  // 5. Page restore (Chrome bfcache killer)
  window.addEventListener("pageshow", function (e) {
    if (e.persisted) {
      location.replace(location.href);
    }
  });

})();
</script>






