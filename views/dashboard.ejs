  Total Revenue :-  
  <span style="color:#2563eb;">
    <%= Number(service_revenue) + Number(cab_revenue) %>
  </span>
</h5>

   
  </div>

  <!-- RIGHT : FILTER FORM -->
  <div class="col-sm-7">
    <form method="GET"
          action="/dashboard"
          class="row g-2 justify-content-end align-items-end">

      <div class="col-sm-4">
        <label class="form-label form-label-sm mb-1">From Date</label>
        <input
          type="date"
          name="from"
          class="form-control form-control-sm"
          value="<%= from || '' %>"
          required
        >
      </div>

      <div class="col-sm-4">
        <label class="form-label form-label-sm mb-1">To Date</label>
        <input
          type="date"
          name="to"
          class="form-control form-control-sm"
          value="<%= to || '' %>"
          required
        >
      </div>

      <div class="col-sm-4 d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary w-100">
          Filter
        </button>

        <a href="/dashboard" class="btn btn-sm btn-secondary w-100">
          Reset
        </a>
      </div>

    </form>
  </div>

</div>



