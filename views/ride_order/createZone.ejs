<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="main-content">

  <!-- 🔹 Buttons / Tabs -->
  <div class="col-12 mb-3">
    <button class="btn me-2" onclick="showTab('list')" style="background-color:blue; color:white">Zone List</button>
    <button class="btn " onclick="showTab('create')"  style="background-color:blue; color:white;">Create Zone</button>
  </div>

  <!-- 🔹 Zone List -->
  <div id="zoneList" class="col-12" style="display: <%= activeTab === 'list' ? 'block' : 'none' %>;">
    <div class="card p-3">
      <h4>Zone List</h4>

  
      <table class="table table-bordered mt-2">
        <thead>
          <tr>
            <th>ID</th>
            <th>Zone Name</th>
            <th>Created Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (zones.length > 0) { %>
            <% zones.forEach(zone => { %>
              <tr>
                <td><%= zone.id %></td>
                <td><%= zone.zone_name %></td>
                <td><%= new Date(zone.created_at).toLocaleString() %></td>
                <td>
                  <form id="deleteForm-<%= zone.id %>" action="/zones/delete/<%= zone.id %>" method="POST">
                    <button type="button" class="btn btn-sm btn-danger" 
                      onclick="confirmDelete(<%= zone.id %>)" title="Delete Zone">
                      <i class="fa fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="4" class="text-center text-muted">No zones found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>

    </div>
  </div>

  <!-- 🔹 Create Zone Form -->
  <div id="createZone" class="col-12" style="display: <%= activeTab === 'create' ? 'block' : 'none' %>;">
    <div class="card p-3">
      <h4>Create Zone</h4>
      <form action="/zones/create" method="POST">
        <div class="mb-3">
          <label class="fw-bold">Zone Name</label>
          <input type="text" name="zone_name" class="form-control" required>
        </div>

        <div id="map" style="width:100%; height:400px; border-radius:10px; overflow:hidden;"></div>
        <input type="hidden" id="coords" name="zone_coordinates">
        <button type="submit" class="btn mt-3"  style="background-color:green;">Save Zone</button>
      </form>
    </div>
  </div>

</div>

<!-- 🔹 JS: Map + Tab Switch + SweetAlert Delete -->
<script>
let polygon = null;

function initMap() {
  const map = new google.maps.Map(document.getElementById("map"), {
    zoom: 12,
    center: { lat: 26.8467, lng: 80.9462 }
  });

  const drawingManager = new google.maps.drawing.DrawingManager({
    drawingControl: true,
    drawingControlOptions: {
      drawingModes: ["polygon"]
    }
  });

  drawingManager.setMap(map);

  google.maps.event.addListener(drawingManager, 'polygoncomplete', function (poly) {
    if (polygon) polygon.setMap(null);
    polygon = poly;

    let coordinates = poly.getPath().getArray().map(point => ({
      lat: point.lat(),
      lng: point.lng()
    }));

    document.getElementById("coords").value = JSON.stringify(coordinates);
  });
}

// Tab Switch
function showTab(tab) {
  document.getElementById("zoneList").style.display = tab === 'list' ? 'block' : 'none';
  document.getElementById("createZone").style.display = tab === 'create' ? 'block' : 'none';

  document.querySelectorAll(".btn").forEach(btn => btn.classList.remove("btn-primary"));
  document.querySelectorAll(".btn").forEach(btn => btn.classList.add("btn-secondary"));

  if(tab==='list') document.querySelector("button[onclick='showTab(\"list\")']").classList.add("btn-primary");
  else document.querySelector("button[onclick='showTab(\"create\")']").classList.add("btn-primary");
}

// SweetAlert Delete
function confirmDelete(id) {
  Swal.fire({
    title: 'Are you sure?',
    text: "You won't be able to revert this!",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#d33',
    cancelButtonColor: '#3085d6',
    confirmButtonText: 'Yes, delete it!',
    reverseButtons: true
  }).then((result) => {
    if (result.isConfirmed) {
      document.getElementById('deleteForm-' + id).submit();
    }
  })
}
</script>

<script async
  src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB0mG3CGok9-9RZau5J_VThUP4OTbQ_SFM&libraries=drawing&callback=initMap">
</script>
