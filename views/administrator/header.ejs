<style>
.flash-message {
  position: relative;
  font-size: 1.2rem;
  display: inline-flex;
  align-items: center;
  padding: 8px 20px;
  border-radius: 2px;
  animation: fadeOut 5s forwards; /* changed to 5s */
  margin-bottom: 10px;
  color: white;
}

.flash-success {
  background-color: #28a745;
}

.flash-error {
  background-color: #dc3545;
}

.flash-underline {
  height: 4px;
  background-color: rgba(255, 255, 255, 0.9);
  width: 100%;
  position: absolute;
  bottom: 0;
  left: 0;
  animation: underlineShrink 5s linear forwards; /* changed to 5s */
}

@keyframes underlineShrink {
  from { width: 100%; }
  to { width: 0%; }
}

@keyframes fadeOut {
  0%, 85% { opacity: 1; }
  100% { opacity: 0; }
}
</style>


<script>
document.addEventListener("DOMContentLoaded", () => {
  setTimeout(() => {
    document.querySelectorAll('.flash-message').forEach(el => el.remove());
  }, 5000); // changed to 5s
});
</script>


