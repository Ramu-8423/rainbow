<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
  <title>Admin-Dashboard</title>
  
  <!-- General CSS Files -->
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/app.min.css">

  <!-- Template CSS -->
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/style.css">
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/components.css">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/custom.css">

  <link rel="shortcut icon" type="image/x-icon" href="<%= BASE_URL %>/assets/img/favicon.ico" />

  <style>
    th {
      white-space: nowrap;
      text-overflow: ellipsis;
      background-color: black !important;
      color: white !important;
    }
    td {
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  </style>
 
 
<style>
/* Full screen loader wrapper */
.page-loader{
  position: fixed;
  inset: 0;
  background: rgba(255,255,255,0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

/* NEW loader class */
.cute-loader{
  width: 70px;
  height: 70px;
  border-radius: 50%;
  border: 6px solid #e5e7eb;
  border-top-color: #6777ef;
  border-right-color: #ffa426;
  animation: spinCute 1s linear infinite;
  box-shadow: 0 0 18px rgba(103,119,239,0.35);
}

@keyframes spinCute{
  to{
    transform: rotate(360deg);
  }
}

</style>

</head>

<body>
 
 
 <div class="page-loader">
  <div class="cute-loader"></div>
</div>

 
  
<script>
  window.addEventListener("load", function () {
    const loader = document.querySelector(".page-loader");
    if (loader) loader.style.display = "none";
  });
</script>



  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>

      <!-- Navbar include -->
      <%- include("header") %>

      <!-- Sidebar include -->
      <%- include("sidebar") %>

      <!-- Page Content -->
       <%- body %> 

    </div>
  </div>










 <div class="settingSidebar">
          <a href="javascript:void(0)" class="settingPanelToggle"> <i class="fa fa-spin fa-cog"></i>
          </a>
          <div class="settingSidebar-body ps-container ps-theme-default">
            <div class=" fade show active">
              <div class="setting-panel-header">Setting Panel
              </div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Select Layout</h6>
                <div class="selectgroup layout-color w-50">
                  <label class="selectgroup-item">
                    <input type="radio" name="value" value="1" class="selectgroup-input-radio select-layout" checked>
                    <span class="selectgroup-button">Light</span>
                  </label>
                  <label class="selectgroup-item">
                    <input type="radio" name="value" value="2" class="selectgroup-input-radio select-layout">
                    <span class="selectgroup-button">Dark</span>
                  </label>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Sidebar Color</h6>
                <div class="selectgroup selectgroup-pills sidebar-color">
                  <label class="selectgroup-item">
                    <input type="radio" name="icon-input" value="1" class="selectgroup-input select-sidebar">
                    <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip"
                      data-original-title="Light Sidebar"><i class="fas fa-sun"></i></span>
                  </label>
                  <label class="selectgroup-item">
                    <input type="radio" name="icon-input" value="2" class="selectgroup-input select-sidebar" checked>
                    <span class="selectgroup-button selectgroup-button-icon" data-toggle="tooltip"
                      data-original-title="Dark Sidebar"><i class="fas fa-moon"></i></span>
                  </label>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <h6 class="font-medium m-b-10">Color Theme</h6>
                <div class="theme-setting-options">
                  <ul class="choose-theme list-unstyled mb-0">
                    <li title="white" class="active">
                      <div class="white"></div>
                    </li>
                    <li title="cyan">
                      <div class="cyan"></div>
                    </li>
                    <li title="black">
                      <div class="black"></div>
                    </li>
                    <li title="purple">
                      <div class="purple"></div>
                    </li>
                    <li title="orange">
                      <div class="orange"></div>
                    </li>
                    <li title="green">
                      <div class="green"></div>
                    </li>
                    <li title="red">
                      <div class="red"></div>
                    </li>
                  </ul>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <div class="theme-setting-options">
                  <label class="m-b-0">
                    <input type="checkbox" name="custom-switch-checkbox" class="custom-switch-input"
                      id="mini_sidebar_setting">
                    <span class="custom-switch-indicator"></span>
                    <span class="control-label p-l-10">Mini Sidebar</span>
                  </label>
                </div>
              </div>
              <div class="p-15 border-bottom">
                <div class="theme-setting-options">
                  <label class="m-b-0">
                    <input type="checkbox" name="custom-switch-checkbox" class="custom-switch-input"
                      id="sticky_header_setting">
                    <span class="custom-switch-indicator"></span>
                    <span class="control-label p-l-10">Sticky Header</span>
                  </label>
                </div>
              </div>
              <div class="mt-4 mb-4 p-3 align-center rt-sidebar-last-ele">
                <a href="#" class="btn btn-icon icon-left btn-primary btn-restore-theme">
                  <i class="fas fa-undo"></i> Restore Default
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <footer class="main-footer">
        <div class="footer-left">
          <a href="templateshub.net">Templateshub</a></a>
        </div>
        <div class="footer-right">
        </div>
      </footer>
    </div>
  </div>
  
  
<script>
window.addEventListener("load", function () {

  setTimeout(() => {

    const layout  = localStorage.getItem("layout");        // 1 = Light, 2 = Dark
    const sidebar = localStorage.getItem("sidebar");      // 1 = Light, 2 = Dark
    const theme   = localStorage.getItem("theme");        // white, black, cyan...
    const mini    = localStorage.getItem("mini_sidebar"); // true / false
    const sticky  = localStorage.getItem("sticky_header");// true / false

    /* =========================
       RESTORE LAYOUT (IMPORTANT)
       This controls HEADER + BODY + FOOTER
    ========================= */
    if (layout) {
      const layoutEl = document.querySelector(
        `.select-layout[value="${layout}"]`
      );
      if (layoutEl && !layoutEl.checked) {
        layoutEl.click();
      }
    }

    /* =========================
       RESTORE SIDEBAR COLOR
       This controls ONLY sidebar
    ========================= */
    if (sidebar) {
      const sidebarEl = document.querySelector(
        `.select-sidebar[value="${sidebar}"]`
      );
      if (sidebarEl && !sidebarEl.checked) {
        sidebarEl.click();
      }
    }

    /* =========================
       RESTORE COLOR THEME
       Accent / Primary colors
    ========================= */
    if (theme) {
      const themeEl = document.querySelector(
        `.choose-theme li[title="${theme}"]`
      );
      if (themeEl && !themeEl.classList.contains("active")) {
        themeEl.click();
      }
    }

    /* =========================
       MINI SIDEBAR
    ========================= */
    if (mini === "true") {
      const el = document.getElementById("mini_sidebar_setting");
      if (el && !el.checked) el.click();
    }

    /* =========================
       STICKY HEADER
    ========================= */
    if (sticky === "true") {
      const el = document.getElementById("sticky_header_setting");
      if (el && !el.checked) el.click();
    }

  }, 300); // ⬅️ Template load delay (VERY IMPORTANT)

  /* =====================================================
     SAVE STATE EVENTS
  ===================================================== */

  // Layout (Light / Dark)
  document.querySelectorAll(".select-layout").forEach(el => {
    el.addEventListener("change", () => {
      localStorage.setItem("layout", el.value);
    });
  });

  // Sidebar color
  document.querySelectorAll(".select-sidebar").forEach(el => {
    el.addEventListener("change", () => {
      localStorage.setItem("sidebar", el.value);
    });
  });

  // Color theme
  document.querySelectorAll(".choose-theme li").forEach(li => {
    li.addEventListener("click", () => {
      localStorage.setItem("theme", li.getAttribute("title"));
    });
  });

  // Mini sidebar
  document.getElementById("mini_sidebar_setting")
    ?.addEventListener("change", e => {
      localStorage.setItem("mini_sidebar", e.target.checked);
    });

  // Sticky header
  document.getElementById("sticky_header_setting")
    ?.addEventListener("change", e => {
      localStorage.setItem("sticky_header", e.target.checked);
    });

  // Restore default
  document.querySelector(".btn-restore-theme")
    ?.addEventListener("click", () => {
      localStorage.clear();
      location.reload(); // 🔄 reset UI fully
    });

});
</script>


  
  <!-- JS Scripts -->
  <script src="<%= BASE_URL %>/assets/js/app.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- JS Libraries -->
  <script src="<%= BASE_URL %>/assets/bundles/apexcharts/apexcharts.min.js"></script>

  <!-- Page Specific JS -->
  <script src="<%= BASE_URL %>/assets/js/page/index.js"></script>

  <!-- Template JS -->
  <script src="<%= BASE_URL %>/assets/js/scripts.js"></script>

  <!-- Custom JS -->
  <script src="<%= BASE_URL %>/assets/js/custom.js"></script>
</body>
</html>
