<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
  <title>Admin-Dashboard</title>
  
  <!-- General CSS Files -->
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/app.min.css">

  <!-- Template CSS -->
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/style.css">
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/components.css">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="<%= BASE_URL %>/assets/css/custom.css">

  <link rel="shortcut icon" type="image/x-icon" href="<%= BASE_URL %>/assets/img/favicon.ico" />

  <style>
    th {
      white-space: nowrap;
      text-overflow: ellipsis;
      background-color: black !important;
      color: white !important;
    }
    td {
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  </style>
 
 
<style>
/* Full screen loader wrapper */
.page-loader{
  position: fixed;
  inset: 0;
  background: rgba(255,255,255,0.96);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

/* NEW loader class */
.cute-loader{
  width: 70px;
  height: 70px;
  border-radius: 50%;
  border: 6px solid #e5e7eb;
  border-top-color: #6777ef;
  border-right-color: #ffa426;
  animation: spinCute 1s linear infinite;
  box-shadow: 0 0 18px rgba(103,119,239,0.35);
}

@keyframes spinCute{
  to{
    transform: rotate(360deg);
  }
}

</style>

</head>

<body>
 
 
 <div class="page-loader">
  <div class="cute-loader"></div>
</div>

 
  
<script>
  window.addEventListener("load", function () {
    const loader = document.querySelector(".page-loader");
    if (loader) loader.style.display = "none";
  });
</script>



  <div id="app">
    <div class="main-wrapper main-wrapper-1">
      <div class="navbar-bg"></div>

      <!-- Navbar include -->
      <%- include("header") %>

      <!-- Sidebar include -->
      <%- include("sidebar") %>

      <!-- Page Content -->
       <%- body %> 

    </div>
  </div>

  <!-- JS Scripts -->
  <script src="<%= BASE_URL %>/assets/js/app.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- JS Libraries -->
  <script src="<%= BASE_URL %>/assets/bundles/apexcharts/apexcharts.min.js"></script>

  <!-- Page Specific JS -->
  <script src="<%= BASE_URL %>/assets/js/page/index.js"></script>

  <!-- Template JS -->
  <script src="<%= BASE_URL %>/assets/js/scripts.js"></script>

  <!-- Custom JS -->
  <script src="<%= BASE_URL %>/assets/js/custom.js"></script>
</body>
</html>
