<%
  var path = typeof activePath !== "undefined" ? activePath : "";
  var parts = path.split("/");
  var routeName = parts[1] || "";
  var routeParam = parts[2] || "";
%>

<div class="main-sidebar sidebar-style-2">
  <aside id="sidebar-wrapper">

    <div class="sidebar-brand">
      <a href="#">
        <img alt="image" src="/assets/img/user.png" class="header-logo" />
        <span class="logo-name">Admin</span>
      </a>
    </div>

    <ul class="sidebar-menu">
      <li class="menu-header">Handyman Section</li>

      <!-- Dashboard -->
      <li class="<%= path === '/dashboard' ? 'active' : '' %>">
        <a href="/dashboard" class="nav-link">
          <i data-feather="monitor" style="color:#4e73df;"></i>
          <span>Dashboard</span>
        </a>
      </li>

      <!-- Job Applications -->
      <li class="<%= path.startsWith('/job-applications') ? 'active' : '' %>">
        <a href="/job-applications" class="nav-link">
          <i data-feather="file-text" style="color:#1cc88a;"></i>
          <span>Applications</span>
        </a>
      </li>

      <!-- Users -->
      <li class="<%= path.startsWith('/all-users') ? 'active' : '' %>">
        <a href="/all-users" class="nav-link">
          <i data-feather="users" style="color:#36b9cc;"></i>
          <span>Users</span>
        </a>
      </li>

      <!-- Categories -->
      <li class="<%= path.startsWith('/categories') ? 'active' : '' %>">
        <a href="/categories" class="nav-link">
          <i data-feather="layers" style="color:#f6c23e;"></i>
          <span>Categories</span>
        </a>
      </li>

      <!-- Subcategories -->
      <li class="<%= path.startsWith('/subcategories') ? 'active' : '' %>">
        <a href="/subcategories" class="nav-link">
          <i data-feather="grid" style="color:#e74a3b;"></i>
          <span>Subcategories</span>
        </a>
      </li>

      <!-- Services -->
      <li class="<%= path.startsWith('/services') ? 'active' : '' %>">
        <a href="/services/1" class="nav-link">
          <i data-feather="grid" style="color:#e74a3b;"></i>
          <span>Services</span>
        </a>
      </li>

      <!-- Bank Details (PARAM = 1 only) -->
      <li class="<%= routeName === 'bank-details' && routeParam === '1' ? 'active' : '' %>">
        <a href="/bank-details/1" class="nav-link">
          <i data-feather="credit-card" style="color:#6610f2;"></i>
          <span>Bank Details</span>
        </a>
      </li>

      <!-- Bank Update Request (PARAM = 1 only) -->
      <li class="<%= routeName === 'bank-update-request' && routeParam === '1' ? 'active' : '' %>">
        <a href="/bank-update-request/1" class="nav-link">
          <i data-feather="refresh-cw" style="color:#20c997;"></i>
          <span>Bank Update Request</span>
        </a>
      </li>

      <li class="menu-header">Cab Booking Section</li>

      <li class="<%= path.startsWith('/all-drivers') ? 'active' : '' %>">
        <a href="/all-drivers" class="nav-link">
          <i data-feather="refresh-cw" style="color:#20c997;"></i>
          <span>All Drivers</span>
        </a>
      </li>

      <!-- Driver Bank Details (PARAM = 2 only) -->
      <li class="<%= routeName === 'bank-details' && routeParam === '2' ? 'active' : '' %>">
        <a href="/bank-details/2" class="nav-link">
          <i data-feather="credit-card" style="color:#6610f2;"></i>
          <span>Driver Bank Details</span>
        </a>
      </li>

      <!-- Driver Bank Update Request (PARAM = 2 only) -->
      <li class="<%= routeName === 'bank-update-request' && routeParam === '2' ? 'active' : '' %>">
        <a href="/bank-update-request/2" class="nav-link">
          <i data-feather="refresh-cw" style="color:#20c997;"></i>
          <span>Bank Update Request</span>
        </a>
      </li>


<li class="menu-header">Vehicle Management</li>

<li class="<%= path === '/vehicle-list' ? 'active' : '' %>">
  <a href="/vehicle-list" class="nav-link text-dark">
    <i data-feather="truck" style="color:#4e73df;"></i>
    <span>Vehicle List</span>
  </a>
</li>

<!-- Brand List -->
<li class="<%= path === '/brand-list' ? 'active' : '' %>">
  <a href="/brand-list" class="nav-link text-dark">
    <i data-feather="tag" style="color:#1cc88a;"></i>
    <span>Brand List</span>
  </a>
</li>

<!-- Model List -->
<li class="<%= path === '/model-list' ? 'active' : '' %>">
  <a href="/model-list" class="nav-link text-dark">
    <i data-feather="layers" style="color:#f6c23e;"></i>
    <span>Model List</span>
  </a>
</li>

<li class="<%= path === '/vehicle-amount-list' ? 'active' : '' %>">
  <a href="/vehicle-amount-list" class="nav-link text-dark">
    <i data-feather="dollar-sign" style="color:#36b9cc;"></i>
    <span>Vehicle Amount List</span>
  </a>
</li>

<li class="<%= path === '/settings' ? 'active' : '' %>">
  <a href="/settings" class="nav-link text-dark">
    <i data-feather="dollar-sign" style="color:#36b9cc;"></i>
    <span>Settings</span>
  </a>
</li>

      <!-- Logout -->
      <li>
        <a href="/logout" class="nav-link">
          <i data-feather="log-out" style="color:#858796;"></i>
          <span>Logout</span>
        </a>
      </li>

    </ul>
  </aside>
</div>
