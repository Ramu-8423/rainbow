<style>
  /* ===========================
     PAGINATION (same as users)
  =========================== */
  .pagination-container{
    margin-top:25px;
    padding:12px 10px;
    display:flex;
    flex-wrap:wrap;
    justify-content:space-between;
    align-items:center;
    border-top:1px solid #ddd;
    gap:12px
  }
  .pagination-left,.pagination-right{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap
  }
  .pg-btn{
    padding:6px 12px;
    border:1px solid #007bff;
    color:#007bff;
    border-radius:4px;
    text-decoration:none
  }
  .pg-btn:hover{
    background:#007bff;
    color:#fff
  }
  .pg-input{
    width:45px;
    text-align:center
  }

  /* ===========================
     HEADER + FILTER (same users)
  =========================== */
  .card-header{
    gap:10px;
  }

  .filter-form{
    display:flex;
    align-items:center;
    gap:8px;
    flex-wrap:wrap;
  }

  @media(max-width:600px){
    .card-header{
      flex-direction:column;
      align-items:flex-start !important;
    }

    #tableSearch{
      width:100% !important;
      margin:0 !important;
    }

    .filter-form{
      width:100%;
    }

    .filter-form input{
      width:48% !important;
    }

    .filter-form button,
    .filter-form a{
      width:100%;
    }
  }

  .card-header .form-control{
    border-radius:0 !important;
  }
</style>

<script>
  const PAGE_TYPE = "<%= type %>"; // 2 for serviceman
</script>

<div class="main-content">
<section class="section">
<div class="card">

<!-- ================= HEADER (SAME AS DRIVER) ================= -->
<div class="card-header d-flex justify-content-between align-items-center flex-wrap">

<div class="d-flex align-items-center gap-2 flex-wrap">
  <h4 class="mb-0">Serviceman</h4>

  <select
    class="form-select form-select-sm"
    style="width:auto; font-weight:600;"
    onchange="location.href=this.value"
  >
    <% if (!currentStatus) { %>
      <option selected disabled>All</option>
    <% } else if (currentStatus == 1) { %>
      <option selected disabled>Pending</option>
    <% } else if (currentStatus == 2) { %>
      <option selected disabled>Approved</option>
    <% } else if (currentStatus == 3) { %>
      <option selected disabled>Rejected</option>
    <% } %>

    <% if (currentStatus != 1) { %>
      <option value="/serviceman-withdraw-request/1">Pending</option>
    <% } %>
    <% if (currentStatus != 2) { %>
      <option value="/serviceman-withdraw-request/2">Approved</option>
    <% } %>
    <% if (currentStatus != 3) { %>
      <option value="/serviceman-withdraw-request/3">Rejected</option>
    <% } %>
    <% if (currentStatus) { %>
      <option value="/serviceman-withdraw-request">All</option>
    <% } %>
  </select>

  <h4 class="mb-0 ml-2">Withdraw</h4>
</div>

<input
  type="text"
  id="tableSearch"
  placeholder="Search..."
  class="form-control mx-3"
  style="width:200px;"
>

<form class="filter-form" method="GET">
  <input type="date" name="from" value="<%= from || '' %>" class="form-control" style="width:150px;">
  <input type="date" name="to" value="<%= to || '' %>" class="form-control" style="width:150px;">

  <button class="btn btn-primary btn-sm" style="border-radius:0;">
    Filter
  </button>

  <a href="/serviceman-withdraw-request"
     class="btn btn-warning btn-sm"
     style="border-radius:0;">
    Reset
  </a>
</form>

</div>

<!-- ================= BODY ================= -->
<div class="card-body">
<div class="table-responsive">

<table class="table table-bordered table-striped">
<thead>
<tr>
  <th>ID</th>
  <th>User ID</th>
  <th>Amount</th>
  <th>Transaction ID</th>
  <th>Status</th>
  <th>Rejected Reason</th>
  <th>Date</th>
</tr>
</thead>

<tbody>
<% if(requests.length){ %>
<% requests.forEach(r=>{ %>
<tr>
  <td><%= r.id %></td>
  <td><%= r.user_id %></td>
  <td>₹ <%= r.amount %></td>
  <td><%= r.transaction_id || "-" %></td>

  <td>
    <select
      onchange="handleStatusChange(this,'<%= r.id %>','<%= r.user_type %>')"
      <%= r.status==2?'disabled':'' %>
      style="
        width:110px;
        padding:3px 6px;
        font-size:13px;
        border-radius:3px;
        cursor:<%= r.status==2 ? 'not-allowed' : 'pointer' %>;
        font-weight:600;
        vertical-align:middle;
        border:1px solid <%= 
          r.status==0 ? '#ffc107' :
          r.status==1 ? '#28a745' :
          '#dc3545'
        %>;
        color:<%= 
          r.status==0 ? '#ffc107' :
          r.status==1 ? '#28a745' :
          '#dc3545'
        %>;
      "
    >
      <option value="0" <%= r.status==0?'selected':'' %>>Pending</option>
      <option value="1" <%= r.status==1?'selected':'' %>>Approved</option>
      <option value="2" <%= r.status==2?'selected':'' %>>Rejected</option>
    </select>
  </td>

  <td>
    <%= r.status == 2 ? (r.rejected_reason || 'N/A') : 'N/A' %>
  </td>

  <td><%= r.created_at %></td>
</tr>
<% }) %>
<% } else { %>
<tr>
  <td colspan="7" class="text-center">No records found</td>
</tr>
<% } %>
</tbody>
</table>

</div>

<!-- ================= PAGINATION ================= -->
<div class="pagination-container">
  <div class="pagination-left">
    <span>
      <%= (page-1)*perPage+1 %> –
      <%= Math.min(page*perPage,total) %> of <%= total %>
    </span>
  </div>

  <div class="pagination-right">
    <a href="?page=1&perPage=<%= perPage %>&type=<%= type %>" class="pg-btn">&laquo;</a>
    <a href="?page=<%= page>1?page-1:1 %>&perPage=<%= perPage %>&type=<%= type %>" class="pg-btn">Previous</a>
    <input readonly value="<%= page %>" class="pg-input">
    <span>of <%= totalPages %></span>
    <a href="?page=<%= page<totalPages?page+1:totalPages %>&perPage=<%= perPage %>&type=<%= type %>" class="pg-btn">Next</a>
  </div>
</div>

</div>
</div>
</section>
</div>

<!-- ================= MODALS ================= -->
<div class="modal fade" id="approveModal">
<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">
  <div class="modal-header"><h5>Approve Withdraw</h5></div>
  <div class="modal-footer">
    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button class="btn btn-success" onclick="confirmApprove()">Approve</button>
  </div>
</div>
</div>
</div>

<div class="modal fade" id="rejectModal">
<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">
  <div class="modal-header"><h5>Reject Withdraw</h5></div>
  <div class="modal-body">
   <textarea
  id="rejectReason"
  class="form-control"
  placeholder="Reason"
  oninput="validateRejectReason(this)"
></textarea>

<span
  id="rejectError"
  style="color:red; font-size:13px; display:none; margin-top:5px;"
></span>

  </div>
  <div class="modal-footer">
    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button class="btn btn-danger" onclick="confirmReject()">Reject</button>
  </div>
</div>
</div>
</div>

<script>
/* ===============================
   GLOBALS
================================ */
let currentId = null;
let currentType = null;

const MAX_REASON_LEN = 100;

/* ===============================
   STATUS CHANGE HANDLER
================================ */
function handleStatusChange(sel, id, type){
  currentId = id;
  currentType = type;

  // reset reject modal fields
  const reason = document.getElementById("rejectReason");
  const error = document.getElementById("rejectError");
  if (reason) reason.value = "";
  if (error) error.style.display = "none";

  if (sel.value == 1) {
    new bootstrap.Modal(document.getElementById("approveModal")).show();
  }

  if (sel.value == 2) {
    new bootstrap.Modal(document.getElementById("rejectModal")).show();
  }
}

/* ===============================
   APPROVE
================================ */
function confirmApprove(){
  if (!currentId || !currentType) return;

  location.href =
    `/update-serviceman-withdraw-request/${currentId}` +
    `?status=1&type=${currentType}`;
}

/* ===============================
   LIVE REJECT VALIDATION
================================ */
function validateRejectReason(el){
  const errorSpan = document.getElementById("rejectError");
  const len = el.value.length;

  if (len > MAX_REASON_LEN) {
    el.value = el.value.substring(0, MAX_REASON_LEN);
    errorSpan.style.display = "block";
    errorSpan.innerText = `Maximum ${MAX_REASON_LEN} characters allowed`;
  } else {
    errorSpan.style.display = "none";
    errorSpan.innerText = "";
  }
}

/* ===============================
   CONFIRM REJECT
================================ */
function confirmReject(){
  const reasonInput = document.getElementById("rejectReason");
  const errorSpan = document.getElementById("rejectError");
  const reason = reasonInput.value.trim();

  if (!reason) {
    errorSpan.style.display = "block";
    errorSpan.innerText = "Reason is required";
    reasonInput.focus();
    return;
  }

  if (reason.length > MAX_REASON_LEN) {
    errorSpan.style.display = "block";
    errorSpan.innerText = `Maximum ${MAX_REASON_LEN} characters allowed`;
    reasonInput.focus();
    return;
  }

  location.href =
    `/update-serviceman-withdraw-request/${currentId}` +
    `?status=2&type=${currentType}&reason=${encodeURIComponent(reason)}`;
}

/* ===============================
   TABLE SEARCH
================================ */
document.getElementById("tableSearch").addEventListener("keyup", function(e){
  const val = e.target.value.toLowerCase();
  document.querySelectorAll("tbody tr").forEach(tr => {
    tr.style.display = tr.innerText.toLowerCase().includes(val) ? "" : "none";
  });
});
</script>
