<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Verify OTP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      height: 100vh;
      background: radial-gradient(circle at top left, #3bc9db, transparent 40%),
                  radial-gradient(circle at top right, #d63384, transparent 40%),
                  radial-gradient(circle at bottom right, #fd7e14, transparent 40%),
                  #0f172a;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .glass-card {
      max-width:380px;
      padding:30px;
      border-radius:16px;
      background:rgba(255,255,255,0.18);
      backdrop-filter:blur(18px);
      color:#fff;
    }
    .form-control {
      background:rgba(255,255,255,0.25);
      border:none;
      color:#fff;
    }
  </style>
</head>
<body>

<div class="glass-card">
  <h4 class="text-center mb-3">Reset Password</h4>

  <% if (error) { %>
    <div class="text-danger text-center mb-2"><%= error %></div>
  <% } %>

  <% if (success) { %>
    <div class="text-success text-center mb-2"><%= success %></div>
  <% } %>

  <form method="POST" action="/verify-otp/<%= adminId %>">
    <label>OTP</label>
    <input type="text" name="otp" class="form-control mb-2" required>

    <label>New Password</label>
    <input type="password" name="password" class="form-control mb-2" required>

    <label>Confirm Password</label>
    <input type="password" name="confirm_password" class="form-control mb-3" required>

    <button class="btn btn-gradient w-100">Reset Password</button>
  </form>
</div>

</body>
</html>
