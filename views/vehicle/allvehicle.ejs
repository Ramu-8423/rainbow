<style>
.file-box{
  width:50px;height:50px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:6px;
  overflow:hidden;
  background:#f1f1f1;
}
.file-thumb{width:100%;height:100%;object-fit:cover}
.card-header{gap:10px}
.card-header .form-control{border-radius:0!important}
.error-text{
  display:block;
  margin-top:4px;
  color:red;
  font-size:12px;
}

/* ===== MODAL GRID LAYOUT (NEW) ===== */
.vehicle-form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}
.vehicle-form-grid .full{
  grid-column:1 / -1;
}
@media(max-width:768px){
  .vehicle-form-grid{
    grid-template-columns:1fr;
  }
}
</style>

<div class="main-content">
<section class="section">
<div class="card">

<div class="card-header d-flex justify-content-between align-items-center flex-wrap">
  <h4 class="mb-0">Vehicle List</h4>

  <input type="text" id="tableSearch" class="form-control mx-3"
         placeholder="Search..." style="width:220px;">

  <button class="btn btn-primary btn-sm"
          style="border-radius:0;margin-left:auto;"
          onclick="openAddVehicleModal()">
    + Add Vehicle
  </button>
</div>

<div class="card-body">
<div class="table-responsive">
<table class="table table-bordered table-striped">
<thead>
<tr>
  <th>ID</th>
  <th>Name</th>
  <th>Max Passenger</th>
  <th>Image</th>
  <th>User Increase Amount</th>
  <th>User Decrease Amount</th>
  <th>Driver Can Register</th>
  <th>User Booking Status</th>
  <th>Action</th>
  <th>Date</th>
</tr>
</thead>

<tbody>
<% if(vehicles.length){ vehicles.forEach(v=>{ %>
<tr>
  <td><%= v.id %></td>
  <td><%= v.name %></td>
  <td><%= v.max_passenger %></td>

  <td>
    <% if(v.image){ %>
      <div class="file-box">
        <img src="/<%= v.image %>" class="file-thumb"
             onclick="openImageModal('/<%= v.image %>')">
      </div>
    <% } else { %>—<% } %>
  </td>

  <td><%= v.user_increase ?? 0 %>%</td>
  <td><%= v.discount ?? 0 %>%</td>

  <td>
    <select onchange="changeVehicleStatus('<%= v.id %>','register',this.value)"
      style="width:110px;padding:3px 6px;font-size:13px;font-weight:600;
      border:1px solid <%= v.register_status==1?'#28a745':'#dc3545' %>;
      color:<%= v.register_status==1?'#28a745':'#dc3545' %>;">
      <option value="1" <%= v.register_status==1?'selected':'' %>>Can Register</option>
      <option value="0" <%= v.register_status==0?'selected':'' %>>Cannot Register</option>
    </select>
  </td>

  <td>
    <select onchange="changeVehicleStatus('<%= v.id %>','visible',this.value)"
      style="width:110px;padding:3px 6px;font-size:13px;font-weight:600;
      border:1px solid <%= v.visible_status==1?'#28a745':'#dc3545' %>;
      color:<%= v.visible_status==1?'#28a745':'#dc3545' %>;">
      <option value="1" <%= v.visible_status==1?'selected':'' %>>Visible</option>
      <option value="0" <%= v.visible_status==0?'selected':'' %>>Hidden</option>
    </select>
  </td>

  <td>
    <button class="btn btn-sm btn-primary"
      style="border-radius:0;padding:3px 10px"
      onclick="openEditVehicleModal(
        '<%= v.id %>',
        '<%= v.name %>',
        '<%= v.max_passenger %>',
        '<%= v.discount %>',
        '<%= v.user_increase %>',
        '<%= v.vehicle_category %>',
        '<%= v.image %>'
      )">
      Edit
    </button>
  </td>

  <td><%= v.created_at %></td>
</tr>
<% }) } else { %>
<tr><td colspan="10" class="text-center">No Vehicles Found</td></tr>
<% } %>
</tbody>
</table>
</div>
</div>
</div>
</section>
</div>

<!-- ================= EDIT VEHICLE MODAL ================= -->
<div id="editVehicleModal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);
     z-index:99999;justify-content:center;align-items:center">

<div style="background:#fff;padding:24px;width:720px;max-width:95%;
            border-radius:6px;position:relative">

<span onclick="closeEditVehicleModal()"
      style="position:absolute;right:18px;top:10px;
      font-size:26px;cursor:pointer">×</span>

<h5>Edit Vehicle</h5>

<form method="POST" action="/vehicle-update" enctype="multipart/form-data">

<input type="hidden" id="edit_id" name="id">
<input type="hidden" id="old_image" name="old_image">

<div class="vehicle-form-grid">

  <div>
    <label>Vehicle Name</label>
    <input id="edit_name" name="name" class="form-control">
  </div>

  <div>
    <label>Vehicle Type</label>
    <select id="edit_vehicle_type" name="vehicle_type" class="form-control">
      <option value="">Select Type</option>
      <option value="2">2 Wheeler</option>
      <option value="3">3 Wheeler</option>
      <option value="4">4 Wheeler</option>
    </select>
  </div>

  <div>
    <label>Max Passenger</label>
    <input id="edit_passenger" name="max_passenger"
           type="number" class="form-control">
  </div>

  <div>
    <label>User Discount (%)</label>
    <input id="edit_discount" name="discount"
           type="number" class="form-control">
  </div>

  <div>
    <label>User Increase Amount</label>
    <input id="edit_increase" name="user_increase"
           type="number" class="form-control">
  </div>

  <div>
    <label>Vehicle Image</label>
    <input name="image" type="file" class="form-control"
           onchange="previewEditVehicleImage(event)">
  </div>

  <div class="full">
    <div id="editPreviewBox" class="file-box" style="margin-top:6px">
      <img id="editPreviewImg" class="file-thumb">
    </div>
  </div>

</div>

<button class="btn btn-primary btn-sm w-100 mt-3">
  Update Vehicle
</button>

</form>
</div>
</div>

<!-- ================= ADD VEHICLE MODAL ================= -->
<div id="addVehicleModal"
     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);
     z-index:99999;justify-content:center;align-items:center">

<div style="background:#fff;padding:24px;width:720px;max-width:95%;
            border-radius:6px;position:relative">

<span onclick="closeAddVehicleModal()"
      style="position:absolute;right:18px;top:10px;
      font-size:26px;cursor:pointer">×</span>

<h5>Add New Vehicle</h5>

<form method="POST" action="/vehicle-add" enctype="multipart/form-data">

<div class="vehicle-form-grid">

  <div>
    <label>Vehicle Name</label>
    <input name="name" class="form-control">
  </div>

  <div>
    <label>Vehicle Type</label>
    <select name="vehicle_type" class="form-control">
      <option value="">Select Type</option>
      <option value="2">2 Wheeler</option>
      <option value="3">3 Wheeler</option>
      <option value="4">4 Wheeler</option>
    </select>
  </div>

  <div>
    <label>Max Passenger</label>
    <input name="max_passenger" type="number" class="form-control">
  </div>

  <div>
    <label>User Discount (%)</label>
    <input name="discount" type="number" class="form-control">
  </div>

  <div>
    <label>User Increase Amount</label>
    <input name="user_increase" type="number" class="form-control">
  </div>

  <div>
    <label>Vehicle Image</label>
    <input name="image" type="file" class="form-control">
  </div>

</div>

<button class="btn btn-primary btn-sm w-100 mt-3">
  Add Vehicle
</button>

</form>
</div>
</div>

<script>
function openEditVehicleModal(id,name,passenger,discount,increase,category,image){
  edit_id.value=id
  edit_name.value=name
  edit_passenger.value=passenger
  edit_discount.value=discount ?? 0
  edit_increase.value=increase ?? 0
  edit_vehicle_type.value=category
  old_image.value=image ?? ""
  if(image) editPreviewImg.src="/"+image
  editVehicleModal.style.display="flex"
}
function closeEditVehicleModal(){editVehicleModal.style.display="none"}
function openAddVehicleModal(){addVehicleModal.style.display="flex"}
function closeAddVehicleModal(){addVehicleModal.style.display="none"}
function previewEditVehicleImage(e){
  editPreviewImg.src=URL.createObjectURL(e.target.files[0])
}
</script>

<script defer src="/assets/bundles/sweetalert/sweetalert.min.js"></script>
