<style>
  .file-box {
    width: 50px;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f1f1;
    margin-right: 6px;
    cursor: pointer;
    vertical-align: middle;
  }

  .file-box img {
    display: block;
  }

  .file-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdf-icon {
    font-size: 26px;
    color: #dc3545;
  }

  .pdf-icon:hover {
    color: #9b1c27;
  }

  .pagination-container {
    margin-top: 25px;
    padding: 12px 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #ddd;
    gap: 12px;
  }

  .pagination-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pagination-left select {
    padding: 5px 8px;
    border-radius: 4px;
    border: 1px solid #ccc;
  }

  .pagination-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pg-btn {
    padding: 6px 12px;
    border: 1px solid #007bff;
    color: #007bff;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .pg-btn:hover {
    background: #007bff;
    color: #fff;
  }

  .pg-input {
    width: 45px;
    text-align: center;
    padding: 5px;
    border: 1px solid #aaa;
    border-radius: 4px;
  }

  @media(max-width: 600px){
    .pagination-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .pagination-right {
      width: 100%;
      justify-content: space-between;
    }

    .pagination-left {
      width: 100%;
      justify-content: space-between;
    }
  }

  .card-header {
    gap: 10px;
  }

  .filter-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start !important;
    }

    #tableSearch {
      width: 100% !important;
      margin: 0 !important;
    }

    .filter-form {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }

    .filter-form input {
      width: 48% !important;
    }

    .filter-form button,
    .filter-form a {
      width: 100%;
    }
  }

  .card-header .form-control {
    border-radius: 0 !important;
  }
  
  
</style>



<div class="main-content">
  <section class="section">

    <div class="card">

      <div class="card-header d-flex justify-content-between align-items-center flex-wrap">

         <h4 class="mb-0">
  <% if (type == 1) { %>
    Service Man Bank Details
  <% } else if (type == 2) { %>
    Driver Bank Details
  <% } else { %>
    Bank Details
  <% } %>
</h4>

        <!-- SEARCH -->
        <input 
          type="text"
          id="tableSearch"
          placeholder="Search..."
          class="form-control mx-3"
          style="width:220px;"
        />

        <!-- FILTER FORM -->
        <form class="filter-form d-flex align-items-center gap-2" method="GET">

          <input 
            type="date" 
            name="from"
            value="<%= from || '' %>"
            class="form-control"
            style="width:150px;"
          />

          <input 
            type="date" 
            name="to"
            value="<%= to || '' %>"
            class="form-control"
            style="width:150px;"
          />

          <button type="submit" 
            class="btn btn-primary btn-sm"
            style="border-radius:0;">
            Filter
          </button>

          <% if (isFiltered) { %>
            <a href="/bank-details/<%= type %>" 
               class="btn btn-secondary btn-sm"
               style="border-radius:0;">
              Reset
            </a>
          <% } %>

        </form>


      </div>


      <div class="card-body">
        <div class="table-responsive">

          <table class="table table-bordered table-striped">
            <thead>
              <tr>
                <th>ID</th>
                <th>User ID</th>
                <th>Account Holder Name</th>
                <th>Bank Name</th>
                <th>Account No</th>
                <th>IFSC</th>
                <th>Date</th>
              </tr>
            </thead>

            <tbody>
              <% if (banks.length > 0) { %>

                <% banks.forEach(bank => { %>
                  <tr>
                    <td><%= bank.id %></td>
                    <td><%= bank.user_id %></td>
                    <td><%= bank.account_holder_name %></td>
                    <td><%= bank.bank_name %></td>
                    <td><%= bank.account_number %></td>
                    <td><%= bank.ifsc_code %></td>
                    <td><%= bank.datetime %></td>
                  </tr>
                <% }) %>

              <% } else { %>
                <tr><td colspan="10" class="text-center">No records found</td></tr>
              <% } %>
            </tbody>

          </table>
        </div>

        <!-- PAGINATION UI -->
        <div class="pagination-container">

          <div class="pagination-left">
            <span>Items per page:</span>

            <select onchange="changePerPage(this.value)">
              <option value="8" <%= perPage == 8 ? 'selected' : '' %>>8</option>
              <option value="10" <%= perPage == 10 ? 'selected' : '' %>>10</option>
              <option value="15" <%= perPage == 15 ? 'selected' : '' %>>15</option>
              <option value="20" <%= perPage == 20 ? 'selected' : '' %>>20</option>
            </select>

            <span>
              <%= (page - 1) * perPage + 1 %> –
              <%= Math.min(page * perPage, total) %> of <%= total %> items
            </span>
          </div>

          <div class="pagination-right">
            <a href="?page=1&perPage=<%= perPage %>" class="pg-btn">&laquo;</a>

            <a href="?page=<%= page > 1 ? page - 1 : 1 %>&perPage=<%= perPage %>" 
                class="pg-btn">
              Previous
            </a>

            <input type="text" readonly value="<%= page %>" class="pg-input">
            <span>of <%= totalPages %></span>

            <a href="?page=<%= page < totalPages ? page + 1 : totalPages %>&perPage=<%= perPage %>" 
                class="pg-btn">
              Next
            </a>

            <a href="?page=<%= totalPages %>&perPage=<%= perPage %>" class="pg-btn">&raquo;</a>
          </div>

        </div>
        <!-- END PAGINATION -->

      </div>
    </div>

  </section>
</div>


<script>
function changePerPage(val){
  window.location.href = "?page=1&perPage=" + val;
}

document.getElementById("tableSearch").addEventListener("keyup", function(){
  let value = this.value.toLowerCase();
  let rows = document.querySelectorAll("table tbody tr");

  rows.forEach(row => {
    let text = row.innerText.toLowerCase();
    row.style.display = text.includes(value) ? "" : "none";
  });
});
</script>
