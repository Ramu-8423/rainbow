<style>
  .file-box {
    width: 50px;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    overflow: hidden;
    background: #f1f1f1;
    margin-right: 6px;
    cursor: pointer;
    vertical-align: middle;
  }

  .file-box img {
    display: block;
  }

  .file-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdf-icon {
    font-size: 26px;
    color: #dc3545;
  }

  .pdf-icon:hover {
    color: #9b1c27;
  }

  .pagination-container {
    margin-top: 25px;
    padding: 12px 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #ddd;
    gap: 12px;
  }

  .pagination-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pagination-left select {
    padding: 5px 8px;
    border-radius: 4px;
    border: 1px solid #ccc;
  }

  .pagination-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pg-btn {
    padding: 6px 12px;
    border: 1px solid #007bff;
    color: #007bff;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .pg-btn:hover {
    background: #007bff;
    color: #fff;
  }

  .pg-input {
    width: 45px;
    text-align: center;
    padding: 5px;
    border: 1px solid #aaa;
    border-radius: 4px;
  }

  @media(max-width: 600px){
    .pagination-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .pagination-right {
      width: 100%;
      justify-content: space-between;
    }

    .pagination-left {
      width: 100%;
      justify-content: space-between;
    }
  }

  .card-header {
    gap: 10px;
  }

  .filter-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .card-header {
      flex-direction: column;
      align-items: flex-start !important;
    }

    #tableSearch {
      width: 100% !important;
      margin: 0 !important;
    }

    .filter-form {
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
    }

    .filter-form input {
      width: 48% !important;
    }

    .filter-form button,
    .filter-form a {
      width: 100%;
    }
  }

  .card-header .form-control {
    border-radius: 0 !important;
  }
</style>

<script>
  const PAGE_TYPE = "<%= type %>";
</script>



<div class="main-content">
<section class="section">
<div class="card">

<div class="card-header d-flex justify-content-between align-items-center flex-wrap">

<h4 class="mb-0">
<% if(type==1){ %>Service Man Bank Details
<% }else if(type==2){ %>Driver Bank Details
<% }else{ %>Bank Details<% } %>
</h4>


  <!-- SEARCH -->
        <input 
          type="text"
          id="tableSearch"
          placeholder="Search..."
          class="form-control mx-3"
          style="width:220px;"
        />

        <!-- FILTER FORM -->
        <form class="filter-form d-flex align-items-center gap-2" method="GET">

          <input 
            type="date" 
            name="from"
            value="<%= from || '' %>"
            class="form-control"
            style="width:150px;"
          />

          <input 
            type="date" 
            name="to"
            value="<%= to || '' %>"
            class="form-control"
            style="width:150px;"
          />

          <button type="submit" 
            class="btn btn-primary btn-sm"
            style="border-radius:0;">
            Filter
          </button>

          <% if (isFiltered) { %>
            <a href="/bank-update-request/<%= type %>" 
               class="btn btn-secondary btn-sm"
               style="border-radius:0;">
              Reset
            </a>
          <% } %>

        </form>

        


</div>

<!-- ================= BODY ================= -->
<div class="card-body">
<div class="table-responsive">

<table class="table table-bordered table-striped">
<thead>
<tr>
<th>ID</th>
<th>User ID</th>
<th>Bank Name</th>
<th>Account No</th>
<th>Re-Account</th>
<th>Holder</th>
<th>IFSC</th>
<th>Status</th>
<th>Date</th>
</tr>
</thead>

<tbody>
<% if(requests.length>0){ %>
<% requests.forEach(req=>{ %>
<tr>
<td><%= req.id %></td>
<td><%= req.user_id %></td>
<td><%= req.bank_name %></td>
<td><%= req.account_number %></td>
<td><%= req.re_account_number %></td>
<td><%= req.account_holder_name %></td>
<td><%= req.ifsc_code %></td>

<td>
<select
  class="status-select"
  data-prev="<%= req.status %>"
  onchange="handleStatusChange(this,'<%= req.id %>')"
  <%= req.status == 2 ? 'disabled' : '' %>
  style="
    width:110px;
    padding:3px 6px;
    font-size:13px;
    border-radius:3px;
    cursor:<%= req.status == 2 ? 'not-allowed' : 'pointer' %>;
    font-weight:600;

    border:1px solid <%= 
      req.status == 0 ? '#ffc107' : 
      req.status == 1 ? '#28a745' : 
      '#dc3545'
    %>;

    color:<%= 
      req.status == 0 ? '#ffc107' : 
      req.status == 1 ? '#28a745' : 
      '#dc3545'
    %>;

    background-color:<%= req.status == 2 ? '#f8f9fa' : '#fff' %>;
  "
>

  <option value="0"
    style="color:#ffc107; font-weight:600;"
    <%= req.status == 0 ? 'selected' : '' %>>
    Pending
  </option>

  <option value="1"
    style="color:#28a745; font-weight:600;"
    <%= req.status == 1 ? 'selected' : '' %>>
    Approved
  </option>

  <option value="2"
    style="color:#dc3545; font-weight:600;"
    <%= req.status == 2 ? 'selected' : '' %>>
    Rejected
  </option>

</select>
</td>


<td><%= req.created_at %></td>
</tr>
<% }) %>
<% }else{ %>
<tr><td colspan="9" class="text-center">No records found</td></tr>
<% } %>
</tbody>
</table>

</div>

<!-- ================= PAGINATION ================= -->
<div class="pagination-container">

<div class="pagination-left">
<span>Items per page:</span>

<select onchange="changePerPage(this.value)">
<option value="8"  <%= perPage==8?'selected':'' %>>8</option>
<option value="10" <%= perPage==10?'selected':'' %>>10</option>
<option value="15" <%= perPage==15?'selected':'' %>>15</option>
<option value="20" <%= perPage==20?'selected':'' %>>20</option>
</select>

<span>
<%= (page-1)*perPage+1 %> –
<%= Math.min(page*perPage,total) %> of <%= total %>
</span>
</div>

<div class="pagination-right">
<a href="?page=1&perPage=<%= perPage %>" class="pg-btn">&laquo;</a>
<a href="?page=<%= page>1?page-1:1 %>&perPage=<%= perPage %>" class="pg-btn">Previous</a>
<input readonly value="<%= page %>" class="pg-input">
<span>of <%= totalPages %></span>
<a href="?page=<%= page<totalPages?page+1:totalPages %>&perPage=<%= perPage %>" class="pg-btn">Next</a>
<a href="?page=<%= totalPages %>&perPage=<%= perPage %>" class="pg-btn">&raquo;</a>
</div>

</div>

</div>
</div>
</section>
</div>

<!-- ================= MODALS ================= -->
<div class="modal fade" id="approveModal">
<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">
<div class="modal-header">
<h5>Approve Request</h5>
<button class="btn-close" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body">Are you sure?</div>
<div class="modal-footer">
<button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
<button class="btn btn-success" onclick="confirmApprove()">Approve</button>
</div>
</div>
</div>
</div>

<div class="modal fade" id="rejectModal">
<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">
<div class="modal-header">
<h5>Reject Request</h5>
<button class="btn-close" data-bs-dismiss="modal">X</button>
</div>
<div class="modal-body">
<textarea id="rejectReason" class="form-control" placeholder="Reject reason"></textarea>
</div>
<div class="modal-footer">
<button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
<button class="btn btn-danger" onclick="confirmReject()">Reject</button>
</div>
</div>
</div>
</div>

<script>
let currentId=null;

function handleStatusChange(select,id){
  currentId=id;
  if(select.value==1)
    new bootstrap.Modal(approveModal).show();
  else if(select.value==2)
    new bootstrap.Modal(rejectModal).show();
}

function confirmApprove(){
  location.href=`/request-status-update/${currentId}?status=1&type=${PAGE_TYPE}`;
}

function confirmReject(){
  const r=document.getElementById("rejectReason").value.trim();
  if(!r) return alert("Reason required");
  location.href=`/request-status-update/${currentId}?status=2&type=${PAGE_TYPE}&reason=${encodeURIComponent(r)}`;
}

function changePerPage(v){
  location.href=`?page=1&perPage=${v}`;
}

document.getElementById("tableSearch").addEventListener("keyup",e=>{
  const v=e.target.value.toLowerCase();
  document.querySelectorAll("tbody tr").forEach(tr=>{
    tr.style.display=tr.innerText.toLowerCase().includes(v)?"":"none";
  });
});
</script>
